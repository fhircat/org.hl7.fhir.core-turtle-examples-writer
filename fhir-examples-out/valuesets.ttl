  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "MedicationDispenseStatusCodes"] ; # 
  fhir:title [ fhir:v "Medication Dispense Status Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International"] ; # 
  fhir:description [ fhir:v "Medication Dispense Status Codes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/medicationDispense-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/medicationDispense-status>
  ] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "preparation" ] ;
     fhir:display [ fhir:v "Preparation" ] ;
     fhir:definition [ fhir:v "The core event has not started yet, but some staging activities have begun (e.g. initial compounding or packaging of medication). Preparation stages may be tracked for billing purposes." ]
  ] [
     fhir:code [ fhir:v "in-progress" ] ;
     fhir:display [ fhir:v "In Progress" ] ;
     fhir:definition [ fhir:v "The dispensed product is ready for pickup." ]
  ] [
     fhir:code [ fhir:v "cancelled" ] ;
     fhir:display [ fhir:v "Cancelled" ] ;
     fhir:definition [ fhir:v "The dispensed product was not and will never be picked up by the patient." ]
  ] [
     fhir:code [ fhir:v "on-hold" ] ;
     fhir:display [ fhir:v "On Hold" ] ;
     fhir:definition [ fhir:v "The dispense process is paused while waiting for an external event to reactivate the dispense.  For example, new stock has arrived or the prescriber has called." ]
  ] [
     fhir:code [ fhir:v "completed" ] ;
     fhir:display [ fhir:v "Completed" ] ;
     fhir:definition [ fhir:v "The dispensed product has been picked up." ]
  ] [
     fhir:code [ fhir:v "entered-in-error" ] ;
     fhir:display [ fhir:v "Entered in Error" ] ;
     fhir:definition [ fhir:v "The dispense was entered in error and therefore nullified." ]
  ] [
     fhir:code [ fhir:v "stopped" ] ;
     fhir:display [ fhir:v "Stopped" ] ;
     fhir:definition [ fhir:v "Actions implied by the dispense have been permanently halted, before all of them occurred." ]
  ] [
     fhir:code [ fhir:v "declined" ] ;
     fhir:display [ fhir:v "Declined" ] ;
     fhir:definition [ fhir:v "The dispense was declined and not performed." ]
  ] [
     fhir:code [ fhir:v "unknown" ] ;
     fhir:display [ fhir:v "Unknown" ] ;
     fhir:definition [ fhir:v "The authoring system does not know which of the status values applies for this medication dispense.  Note: this concept is not to be used for other - one of the listed statuses is presumed to apply, it's just now known which one." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/medicationdispense-status-reason> a fhir:CodeSystem ;
  fhir:id [ fhir:v "medicationdispense-status-reason"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/shareablecodesystem>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/CodeSystem/medicationdispense-status-reason</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">frr01\n                  <a name=\"medicationdispense-status-reason-frr01\"> </a>\n                </td>\n                <td>Order Stopped</td>\n                <td>The order has been stopped by the prescriber but this fact has not necessarily captured electronically. Example: A verbal stop, a fax, etc.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">frr02\n                  <a name=\"medicationdispense-status-reason-frr02\"> </a>\n                </td>\n                <td>Stale-dated Order</td>\n                <td>Order has not been fulfilled within a reasonable amount of time, and might not be current.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">frr03\n                  <a name=\"medicationdispense-status-reason-frr03\"> </a>\n                </td>\n                <td>Incomplete data</td>\n                <td>Data needed to safely act on the order which was expected to become available independent of the order is not yet available. Example: Lab results, diagnostic imaging, etc.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">frr04\n                  <a name=\"medicationdispense-status-reason-frr04\"> </a>\n                </td>\n                <td>Product unavailable</td>\n                <td>Product not available or manufactured. Cannot supply.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">frr05\n                  <a name=\"medicationdispense-status-reason-frr05\"> </a>\n                </td>\n                <td>Ethical/religious</td>\n                <td>The dispenser has ethical, religious or moral objections to fulfilling the order/dispensing the product.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">frr06\n                  <a name=\"medicationdispense-status-reason-frr06\"> </a>\n                </td>\n                <td>Unable to provide care</td>\n                <td>Fulfiller not able to provide appropriate care associated with fulfilling the order. Example: Therapy requires ongoing monitoring by fulfiller and fulfiller will be ending practice, leaving town, unable to schedule necessary time, etc.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">altchoice\n                  <a name=\"medicationdispense-status-reason-altchoice\"> </a>\n                </td>\n                <td>Try another treatment first</td>\n                <td>This therapy has been ordered as a backup to a preferred therapy. This order will be released when and if the preferred therapy is unsuccessful.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">clarif\n                  <a name=\"medicationdispense-status-reason-clarif\"> </a>\n                </td>\n                <td>Prescription/Request requires clarification</td>\n                <td>Clarification is required before the order can be acted upon.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">drughigh\n                  <a name=\"medicationdispense-status-reason-drughigh\"> </a>\n                </td>\n                <td>Drug level too high</td>\n                <td>The current level of the medication in the patient's system is too high. The medication is suspended to allow the level to subside to a safer level.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">hospadm\n                  <a name=\"medicationdispense-status-reason-hospadm\"> </a>\n                </td>\n                <td>Admission to hospital</td>\n                <td>The patient has been admitted to a care facility and their community medications are suspended until hospital discharge.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">labint\n                  <a name=\"medicationdispense-status-reason-labint\"> </a>\n                </td>\n                <td>Lab interference issues</td>\n                <td>The therapy would interfere with a planned lab test and the therapy is being withdrawn until the test is completed.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">non-avail\n                  <a name=\"medicationdispense-status-reason-non-avail\"> </a>\n                </td>\n                <td>Patient not available</td>\n                <td>Patient not available for a period of time due to a scheduled therapy, leave of absence or other reason.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">preg\n                  <a name=\"medicationdispense-status-reason-preg\"> </a>\n                </td>\n                <td>Patient is pregnant or breastfeeding</td>\n                <td>The patient is pregnant or breast feeding. The therapy will be resumed when the pregnancy is complete and the patient is no longer breastfeeding.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">saig\n                  <a name=\"medicationdispense-status-reason-saig\"> </a>\n                </td>\n                <td>Allergy</td>\n                <td>The patient is believed to be allergic to a substance that is part of the therapy and the therapy is being temporarily withdrawn to confirm.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sddi\n                  <a name=\"medicationdispense-status-reason-sddi\"> </a>\n                </td>\n                <td>Drug interacts with another drug</td>\n                <td>The drug interacts with a short-term treatment that is more urgently required. This order will be resumed when the short-term treatment is complete.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sdupther\n                  <a name=\"medicationdispense-status-reason-sdupther\"> </a>\n                </td>\n                <td>Duplicate therapy</td>\n                <td>Another short-term co-occurring therapy fulfills the same purpose as this therapy. This therapy will be resumed when the co-occuring therapy is complete.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sintol\n                  <a name=\"medicationdispense-status-reason-sintol\"> </a>\n                </td>\n                <td>Suspected intolerance</td>\n                <td>The patient is believed to have an intolerance to a substance that is part of the therapy and the therapy is being temporarily withdrawn to confirm.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">surg\n                  <a name=\"medicationdispense-status-reason-surg\"> </a>\n                </td>\n                <td>Patient scheduled for surgery</td>\n                <td>The drug is contraindicated for patients receiving surgery and the patient is scheduled to be admitted for surgery in the near future. The drug will be resumed when the patient has sufficiently recovered from the surgery.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">washout\n                  <a name=\"medicationdispense-status-reason-washout\"> </a>\n                </td>\n                <td>Washout</td>\n                <td>The patient was previously receiving a medication contraindicated with the current medication. The current medication will remain on hold until the prior medication has been cleansed from their system.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">outofstock\n                  <a name=\"medicationdispense-status-reason-outofstock\"> </a>\n                </td>\n                <td>Drug not available - out of stock</td>\n                <td>Drug out of stock. Cannot supply.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">offmarket\n                  <a name=\"medicationdispense-status-reason-offmarket\"> </a>\n                </td>\n                <td>Drug not available - off market</td>\n                <td>Drug no longer marketed Cannot supply.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:code ;
       fhir:v "phx"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/CodeSystem/medicationdispense-status-reason"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/CodeSystem/medicationdispense-status-reason>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.4.1973" ]
  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "MedicationDispenseStatusReasonCodes"] ; # 
  fhir:title [ fhir:v "Medication Dispense Status Reason Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International"] ; # 
  fhir:description [ fhir:v "Medication Dispense Status Reason Codes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/medicationdispense-status-reason"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/medicationdispense-status-reason>
  ] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "frr01" ] ;
     fhir:display [ fhir:v "Order Stopped" ] ;
     fhir:definition [ fhir:v "The order has been stopped by the prescriber but this fact has not necessarily captured electronically. Example: A verbal stop, a fax, etc." ]
  ] [
     fhir:code [ fhir:v "frr02" ] ;
     fhir:display [ fhir:v "Stale-dated Order" ] ;
     fhir:definition [ fhir:v "Order has not been fulfilled within a reasonable amount of time, and might not be current." ]
  ] [
     fhir:code [ fhir:v "frr03" ] ;
     fhir:display [ fhir:v "Incomplete data" ] ;
     fhir:definition [ fhir:v "Data needed to safely act on the order which was expected to become available independent of the order is not yet available. Example: Lab results, diagnostic imaging, etc." ]
  ] [
     fhir:code [ fhir:v "frr04" ] ;
     fhir:display [ fhir:v "Product unavailable" ] ;
     fhir:definition [ fhir:v "Product not available or manufactured. Cannot supply." ]
  ] [
     fhir:code [ fhir:v "frr05" ] ;
     fhir:display [ fhir:v "Ethical/religious" ] ;
     fhir:definition [ fhir:v "The dispenser has ethical, religious or moral objections to fulfilling the order/dispensing the product." ]
  ] [
     fhir:code [ fhir:v "frr06" ] ;
     fhir:display [ fhir:v "Unable to provide care" ] ;
     fhir:definition [ fhir:v "Fulfiller not able to provide appropriate care associated with fulfilling the order. Example: Therapy requires ongoing monitoring by fulfiller and fulfiller will be ending practice, leaving town, unable to schedule necessary time, etc." ]
  ] [
     fhir:code [ fhir:v "altchoice" ] ;
     fhir:display [ fhir:v "Try another treatment first" ] ;
     fhir:definition [ fhir:v "This therapy has been ordered as a backup to a preferred therapy. This order will be released when and if the preferred therapy is unsuccessful." ]
  ] [
     fhir:code [ fhir:v "clarif" ] ;
     fhir:display [ fhir:v "Prescription/Request requires clarification" ] ;
     fhir:definition [ fhir:v "Clarification is required before the order can be acted upon." ]
  ] [
     fhir:code [ fhir:v "drughigh" ] ;
     fhir:display [ fhir:v "Drug level too high" ] ;
     fhir:definition [ fhir:v "The current level of the medication in the patient's system is too high. The medication is suspended to allow the level to subside to a safer level." ]
  ] [
     fhir:code [ fhir:v "hospadm" ] ;
     fhir:display [ fhir:v "Admission to hospital" ] ;
     fhir:definition [ fhir:v "The patient has been admitted to a care facility and their community medications are suspended until hospital discharge." ]
  ] [
     fhir:code [ fhir:v "labint" ] ;
     fhir:display [ fhir:v "Lab interference issues" ] ;
     fhir:definition [ fhir:v "The therapy would interfere with a planned lab test and the therapy is being withdrawn until the test is completed." ]
  ] [
     fhir:code [ fhir:v "non-avail" ] ;
     fhir:display [ fhir:v "Patient not available" ] ;
     fhir:definition [ fhir:v "Patient not available for a period of time due to a scheduled therapy, leave of absence or other reason." ]
  ] [
     fhir:code [ fhir:v "preg" ] ;
     fhir:display [ fhir:v "Patient is pregnant or breastfeeding" ] ;
     fhir:definition [ fhir:v "The patient is pregnant or breast feeding. The therapy will be resumed when the pregnancy is complete and the patient is no longer breastfeeding." ]
  ] [
     fhir:code [ fhir:v "saig" ] ;
     fhir:display [ fhir:v "Allergy" ] ;
     fhir:definition [ fhir:v "The patient is believed to be allergic to a substance that is part of the therapy and the therapy is being temporarily withdrawn to confirm." ]
  ] [
     fhir:code [ fhir:v "sddi" ] ;
     fhir:display [ fhir:v "Drug interacts with another drug" ] ;
     fhir:definition [ fhir:v "The drug interacts with a short-term treatment that is more urgently required. This order will be resumed when the short-term treatment is complete." ]
  ] [
     fhir:code [ fhir:v "sdupther" ] ;
     fhir:display [ fhir:v "Duplicate therapy" ] ;
     fhir:definition [ fhir:v "Another short-term co-occurring therapy fulfills the same purpose as this therapy. This therapy will be resumed when the co-occuring therapy is complete." ]
  ] [
     fhir:code [ fhir:v "sintol" ] ;
     fhir:display [ fhir:v "Suspected intolerance" ] ;
     fhir:definition [ fhir:v "The patient is believed to have an intolerance to a substance that is part of the therapy and the therapy is being temporarily withdrawn to confirm." ]
  ] [
     fhir:code [ fhir:v "surg" ] ;
     fhir:display [ fhir:v "Patient scheduled for surgery" ] ;
     fhir:definition [ fhir:v "The drug is contraindicated for patients receiving surgery and the patient is scheduled to be admitted for surgery in the near future. The drug will be resumed when the patient has sufficiently recovered from the surgery." ]
  ] [
     fhir:code [ fhir:v "washout" ] ;
     fhir:display [ fhir:v "Washout" ] ;
     fhir:definition [ fhir:v "The patient was previously receiving a medication contraindicated with the current medication. The current medication will remain on hold until the prior medication has been cleansed from their system." ]
  ] [
     fhir:code [ fhir:v "outofstock" ] ;
     fhir:display [ fhir:v "Drug not available - out of stock" ] ;
     fhir:definition [ fhir:v "Drug out of stock. Cannot supply." ]
  ] [
     fhir:code [ fhir:v "offmarket" ] ;
     fhir:display [ fhir:v "Drug not available - off market" ] ;
     fhir:definition [ fhir:v "Drug no longer marketed Cannot supply." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/medicationdispense-admin-location> a fhir:CodeSystem ;
  fhir:id [ fhir:v "medicationdispense-admin-location"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/shareablecodesystem>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/medicationdispense-admin-location</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">inpatient\n                  <a name=\"medicationdispense-admin-location-inpatient\"> </a>\n                </td>\n                <td>Inpatient</td>\n                <td>Includes dispenses for medications to be administered or consumed in an inpatient or acute care setting.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">outpatient\n                  <a name=\"medicationdispense-admin-location-outpatient\"> </a>\n                </td>\n                <td>Outpatient</td>\n                <td>Includes dispenses for medications to be administered or consumed in an outpatient setting (for example, Emergency Department, Outpatient Clinic, Outpatient Surgery, Doctor's office).</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">community\n                  <a name=\"medicationdispense-admin-location-community\"> </a>\n                </td>\n                <td>Community</td>\n                <td>Includes dispenses for medications to be administered or consumed by the patient in their home (this would include long term care or nursing homes, hospices, etc.).</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:code ;
       fhir:v "phx"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/medicationdispense-admin-location"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/medicationdispense-admin-location>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.4.1972" ]
  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "MedDispenseAdminLocationCodes"] ; # 
  fhir:title [ fhir:v "Medication Dispense Administration Location Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International"] ; # 
  fhir:description [ fhir:v "Medication Dispense Administration Location Codes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/medicationdispense-admin-location"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/medicationdispense-admin-location>
  ] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "inpatient" ] ;
     fhir:display [ fhir:v "Inpatient" ] ;
     fhir:definition [ fhir:v "Includes dispenses for medications to be administered or consumed in an inpatient or acute care setting." ]
  ] [
     fhir:code [ fhir:v "outpatient" ] ;
     fhir:display [ fhir:v "Outpatient" ] ;
     fhir:definition [ fhir:v "Includes dispenses for medications to be administered or consumed in an outpatient setting (for example, Emergency Department, Outpatient Clinic, Outpatient Surgery, Doctor's office)." ]
  ] [
     fhir:code [ fhir:v "community" ] ;
     fhir:display [ fhir:v "Community" ] ;
     fhir:definition [ fhir:v "Includes dispenses for medications to be administered or consumed by the patient in their home (this would include long term care or nursing homes, hospices, etc.)." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/medicationrequest-status> a fhir:CodeSystem ;
  fhir:id [ fhir:v "medicationrequest-status"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/shareablecodesystem>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/CodeSystem/medicationrequest-status</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td>\n                  <b>Lvl</b>\n                </td>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">active\n                  <a name=\"medicationrequest-status-active\"> </a>\n                </td>\n                <td>Active</td>\n                <td>The request is 'actionable', but not all actions that are implied by it have occurred yet.</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">on-hold\n                  <a name=\"medicationrequest-status-on-hold\"> </a>\n                </td>\n                <td>On Hold</td>\n                <td>Actions implied by the request are to be temporarily halted. The request might or might not be resumed. May also be called 'suspended'.</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">ended\n                  <a name=\"medicationrequest-status-ended\"> </a>\n                </td>\n                <td>Ended</td>\n                <td>The request is no longer active and the subject should no longer be taking the medication.</td>\n              </tr>\n              <tr>\n                <td>2</td>\n                <td style=\"white-space:nowrap\">  stopped\n                  <a name=\"medicationrequest-status-stopped\"> </a>\n                </td>\n                <td>Stopped</td>\n                <td>Actions implied by the request are to be permanently halted, before all of the administrations occurred. This should not be used if the original order was entered in error</td>\n              </tr>\n              <tr>\n                <td>2</td>\n                <td style=\"white-space:nowrap\">  completed\n                  <a name=\"medicationrequest-status-completed\"> </a>\n                </td>\n                <td>Completed</td>\n                <td>All actions that are implied by the request have occurred.</td>\n              </tr>\n              <tr>\n                <td>2</td>\n                <td style=\"white-space:nowrap\">  cancelled\n                  <a name=\"medicationrequest-status-cancelled\"> </a>\n                </td>\n                <td>Cancelled</td>\n                <td>The request has been withdrawn before any administrations have occurred</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">entered-in-error\n                  <a name=\"medicationrequest-status-entered-in-error\"> </a>\n                </td>\n                <td>Entered in Error</td>\n                <td>The request was recorded against the wrong patient or for some reason should not have been recorded (e.g. wrong medication, wrong dose, etc.). Some of the actions that are implied by the medication request may have occurred. For example, the medication may have been dispensed and the patient may have taken some of the medication.</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">draft\n                  <a name=\"medicationrequest-status-draft\"> </a>\n                </td>\n                <td>Draft</td>\n                <td>The request is not yet 'actionable', e.g. it is a work in progress, requires sign-off, verification or needs to be run through decision support process.</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">unknown\n                  <a name=\"medicationrequest-status-unknown\"> </a>\n                </td>\n                <td>Unknown</td>\n                <td>The authoring/source system does not know which of the status values currently applies for this request. Note: This concept is not to be used for 'other' - one of the listed statuses is presumed to apply, but the authoring/source system does not know which.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:code ;
       fhir:v "phx"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/CodeSystem/medicationrequest-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/CodeSystem/medicationrequest-status>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.4.1377" ]
  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "MedicationRequestStatusCodes"] ; # 
  fhir:title [ fhir:v "MedicationRequest Status Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International"] ; # 
  fhir:description [ fhir:v "MedicationRequest Status Codes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/medicationrequest-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/medicationrequest-status>
  ] ; # 
  fhir:hierarchyMeaning [ fhir:v "is-a"] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "active" ] ;
     fhir:display [ fhir:v "Active" ] ;
     fhir:definition [ fhir:v "The request is 'actionable', but not all actions that are implied by it have occurred yet." ]
  ] [
     fhir:code [ fhir:v "on-hold" ] ;
     fhir:display [ fhir:v "On Hold" ] ;
     fhir:definition [ fhir:v "Actions implied by the request are to be temporarily halted. The request might or might not be resumed. May also be called 'suspended'." ]
  ] [
     fhir:code [ fhir:v "ended" ] ;
     fhir:display [ fhir:v "Ended" ] ;
     fhir:definition [ fhir:v "The request is no longer active and the subject should no longer be taking the medication." ] ;
     fhir:concept ( [
       fhir:code [ fhir:v "stopped" ] ;
       fhir:display [ fhir:v "Stopped" ] ;
       fhir:definition [ fhir:v "Actions implied by the request are to be permanently halted, before all of the administrations occurred. This should not be used if the original order was entered in error" ]
     ] [
       fhir:code [ fhir:v "completed" ] ;
       fhir:display [ fhir:v "Completed" ] ;
       fhir:definition [ fhir:v "All actions that are implied by the request have occurred." ]
     ] [
       fhir:code [ fhir:v "cancelled" ] ;
       fhir:display [ fhir:v "Cancelled" ] ;
       fhir:definition [ fhir:v "The request has been withdrawn before any administrations have occurred" ]
     ] )
  ] [
     fhir:code [ fhir:v "entered-in-error" ] ;
     fhir:display [ fhir:v "Entered in Error" ] ;
     fhir:definition [ fhir:v "The request was recorded against the wrong patient or for some reason should not have been recorded (e.g. wrong medication, wrong dose, etc.). Some of the actions that are implied by the medication request may have occurred. For example, the medication may have been dispensed and the patient may have taken some of the medication." ]
  ] [
     fhir:code [ fhir:v "draft" ] ;
     fhir:display [ fhir:v "Draft" ] ;
     fhir:definition [ fhir:v "The request is not yet 'actionable', e.g. it is a work in progress, requires sign-off, verification or needs to be run through decision support process." ]
  ] [
     fhir:code [ fhir:v "unknown" ] ;
     fhir:display [ fhir:v "Unknown" ] ;
     fhir:definition [ fhir:v "The authoring/source system does not know which of the status values currently applies for this request. Note: This concept is not to be used for 'other' - one of the listed statuses is presumed to apply, but the authoring/source system does not know which." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/medicationrequest-intent> a fhir:CodeSystem ;
  fhir:id [ fhir:v "medicationrequest-intent"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/shareablecodesystem>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/CodeSystem/medicationrequest-intent</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td>\n                  <b>Lvl</b>\n                </td>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">proposal\n                  <a name=\"medicationrequest-intent-proposal\"> </a>\n                </td>\n                <td>Proposal</td>\n                <td>The request is a suggestion made by someone/something that doesn't have an intention to ensure it occurs and without providing an authorization to act</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">plan\n                  <a name=\"medicationrequest-intent-plan\"> </a>\n                </td>\n                <td>Plan</td>\n                <td>The request represents an intention to ensure something occurs without providing an authorization for others to act.</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">order\n                  <a name=\"medicationrequest-intent-order\"> </a>\n                </td>\n                <td>Order</td>\n                <td>The request represents a request/demand and authorization for action</td>\n              </tr>\n              <tr>\n                <td>2</td>\n                <td style=\"white-space:nowrap\">  original-order\n                  <a name=\"medicationrequest-intent-original-order\"> </a>\n                </td>\n                <td>Original Order</td>\n                <td>The request represents the original authorization for the medication request.</td>\n              </tr>\n              <tr>\n                <td>2</td>\n                <td style=\"white-space:nowrap\">  reflex-order\n                  <a name=\"medicationrequest-intent-reflex-order\"> </a>\n                </td>\n                <td>Reflex Order</td>\n                <td>The request represents an automatically generated supplemental authorization for action based on a parent authorization together with initial results of the action taken against that parent authorization..</td>\n              </tr>\n              <tr>\n                <td>2</td>\n                <td style=\"white-space:nowrap\">  filler-order\n                  <a name=\"medicationrequest-intent-filler-order\"> </a>\n                </td>\n                <td>Filler Order</td>\n                <td>The request represents the view of an authorization instantiated by a fulfilling system representing the details of the fulfiller's intention to act upon a submitted order.</td>\n              </tr>\n              <tr>\n                <td>3</td>\n                <td style=\"white-space:nowrap\">    instance-order\n                  <a name=\"medicationrequest-intent-instance-order\"> </a>\n                </td>\n                <td>Instance Order</td>\n                <td>The request represents an instance for the particular order and is used to generate a schedule of requests on a medication administration record (MAR).</td>\n              </tr>\n              <tr>\n                <td>1</td>\n                <td style=\"white-space:nowrap\">option\n                  <a name=\"medicationrequest-intent-option\"> </a>\n                </td>\n                <td>Option</td>\n                <td>The request represents a component or option for a RequestOrchestration that establishes timing, conditionality and/or  other constraints among a set of requests.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:code ;
       fhir:v "phx"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/CodeSystem/medicationrequest-intent"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/CodeSystem/medicationrequest-intent>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.4.1378" ]
  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "MedicationRequestIntentCodes"] ; # 
  fhir:title [ fhir:v "MedicationRequest Intent Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International"] ; # 
  fhir:description [ fhir:v "MedicationRequest Intent Codes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/medicationrequest-intent"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/medicationrequest-intent>
  ] ; # 
  fhir:hierarchyMeaning [ fhir:v "is-a"] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "proposal" ] ;
     fhir:display [ fhir:v "Proposal" ] ;
     fhir:definition [ fhir:v "The request is a suggestion made by someone/something that doesn't have an intention to ensure it occurs and without providing an authorization to act" ]
  ] [
     fhir:code [ fhir:v "plan" ] ;
     fhir:display [ fhir:v "Plan" ] ;
     fhir:definition [ fhir:v "The request represents an intention to ensure something occurs without providing an authorization for others to act." ]
  ] [
     fhir:code [ fhir:v "order" ] ;
     fhir:display [ fhir:v "Order" ] ;
     fhir:definition [ fhir:v "The request represents a request/demand and authorization for action" ] ;
     fhir:concept ( [
       fhir:code [ fhir:v "original-order" ] ;
       fhir:display [ fhir:v "Original Order" ] ;
       fhir:definition [ fhir:v "The request represents the original authorization for the medication request." ]
     ] [
       fhir:code [ fhir:v "reflex-order" ] ;
       fhir:display [ fhir:v "Reflex Order" ] ;
       fhir:definition [ fhir:v "The request represents an automatically generated supplemental authorization for action based on a parent authorization together with initial results of the action taken against that parent authorization.." ]
     ] [
       fhir:code [ fhir:v "filler-order" ] ;
       fhir:display [ fhir:v "Filler Order" ] ;
       fhir:definition [ fhir:v "The request represents the view of an authorization instantiated by a fulfilling system representing the details of the fulfiller's intention to act upon a submitted order." ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "instance-order" ] ;
         fhir:display [ fhir:v "Instance Order" ] ;
         fhir:definition [ fhir:v "The request represents an instance for the particular order and is used to generate a schedule of requests on a medication administration record (MAR)." ]
       ] )
     ] )
  ] [
     fhir:code [ fhir:v "option" ] ;
     fhir:display [ fhir:v "Option" ] ;
     fhir:definition [ fhir:v "The request represents a component or option for a RequestOrchestration that establishes timing, conditionality and/or  other constraints among a set of requests." ]
  ] ) . # 

