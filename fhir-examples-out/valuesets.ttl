     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <ul>\n              <li>Include all codes defined in \n                <a href=\"codesystem-medicinal-product-confidentiality.html\">\n                  <code>http://hl7.org/fhir/medicinal-product-confidentiality</code>\n                </a>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral
