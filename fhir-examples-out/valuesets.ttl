hite-space:nowrap\">medline-medline\n                  <a name=\"citation-status-type-medline-medline\"> </a>\n                </td>\n                <td>Medline Citation Status of MEDLINE</td>\n                <td>Medline Citation Status of MEDLINE</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">medline-oldmedline\n                  <a name=\"citation-status-type-medline-oldmedline\"> </a>\n                </td>\n                <td>Medline Citation Status of OLDMEDLINE</td>\n                <td>Medline Citation Status of OLDMEDLINE</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">pubmed-publication-status-ppublish\n                  <a name=\"citation-status-type-pubmed-publication-status-ppublish\"> </a>\n                </td>\n                <td>PubMed PublicationStatus of ppublish</td>\n                <td>published in print</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">pubmed-publication-status-epublish\n                  <a name=\"citation-status-type-pubmed-publication-status-epublish\"> </a>\n                </td>\n                <td>PubMed PublicationStatus of epublish</td>\n                <td>electronically published only, never published in print</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">pubmed-publication-status-aheadofprint\n                  <a name=\"citation-status-type-pubmed-publication-status-aheadofprint\"> </a>\n                </td>\n                <td>PubMed PublicationStatus of aheadofprint</td>\n                <td>electronically published, but followed by print</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
