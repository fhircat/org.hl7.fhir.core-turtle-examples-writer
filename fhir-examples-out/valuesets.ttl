     fhir:v "http://hl7.org/fhir/ValueSet/device-safety"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/device-safety>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.3.213" ]
  ] [
     fhir:use [ fhir:v "old" ] ;
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
