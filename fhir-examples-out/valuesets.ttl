  fhir:description [ fhir:v "The type of link between this Patient resource and other Patient/RelatedPerson resource(s)."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
