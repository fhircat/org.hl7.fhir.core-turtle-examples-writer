  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/combined-dose-form</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000073366\n                  <a name=\"combined-dose-form-100000073366\"> </a>\n                </td>\n                <td>Powder and solvent for oral solution</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000073651\n                  <a name=\"combined-dose-form-100000073651\"> </a>\n                </td>\n                <td>Powder and solvent for oral suspension</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000073774\n                  <a name=\"combined-dose-form-100000073774\"> </a>\n                </td>\n                <td>Eye drops, powder and solvent for solution</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000073781\n                  <a name=\"combined-dose-form-100000073781\"> </a>\n                </td>\n                <td>Eye drops, powder and solvent for suspension</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000073801\n                  <a name=\"combined-dose-form-100000073801\"> </a>\n                </td>\n                <td>Ear drops, powder and solvent for suspension</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000073860\n                  <a name=\"combined-dose-form-100000073860\"> </a>\n                </td>\n                <td>Powder and solv