             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "AuditEvent" ] ;
           fhir:display [ fhir:v "AuditEvent" ] ;
           fhir:definition [ fhir:v "A record of an event relevant for purposes such as operations, privacy, security, maintenance, and performance analysis." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Basic" ] ;
           fhir:display [ fhir:v "Basic" ] ;
           fhir:definition [ fhir:v "Basic is used for handling concepts not yet defined in FHIR, narrative-only resources that don't map to an existing resource, and custom resources not appropriate for inclusion in the FHIR specification." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "BiologicallyDerivedProduct" ] ;
           fhir:display [ fhir:v "BiologicallyDerivedProduct" ] ;
           fhir:definition [ fhir:v "A biological material originating from a biological entity intended to be transplanted or infused into another (possibly the same) biological entity." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "BiologicallyDerivedProductDispense" ] ;
           fhir:display [ fhir:v "BiologicallyDerivedProductDispense" ] ;
           fhir:definition [ fhir:v "A record of dispensation of a biologically derived product." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "BodyStructure" ] ;
           fhir:display [ fhir:v "BodyStructure" ] ;
           fhir:definition [ fhir:v "Record details about an anatomical structure.  This resource may be used when a coded concept does not provide the necessary detail needed for the use case." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CanonicalResource" ] ;
           fhir:display [ fhir:v "CanonicalResource" ] ;
           fhir:definition [ fhir:v "Common Interface declaration for conformance and knowledge artifact resources." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
