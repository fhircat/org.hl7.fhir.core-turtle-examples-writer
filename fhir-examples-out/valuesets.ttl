<http://hl7.org/fhir/CodeSystem/medication-admin-status> a fhir:CodeSystem ;
  fhir:id [ fhir:v "medication-admin-status"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/shareablecodesystem>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/CodeSystem/medication-admin-status</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">in-progress\n                  <a name=\"medication-admin-status-in-progress\"> </a>\n                </td>\n                <td>In Progress</td>\n                <td>The administration has started but has not yet completed.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">not-done\n                  <a name=\"medication-admin-status-not-done\"> </a>\n                </td>\n                <td>Not Done</td>\n                <td>The administration was terminated prior to any impact on the subject (though preparatory actions may have been taken)</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">on-hold\n                  <a name=\"medication-admin-status-on-hold\"> </a>\n                </td>\n                <td>On Hold</td>\n                <td>Actions implied by the administration have been temporarily halted, but are expected to continue later. May also be called 'suspended'.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">completed\n                  <a name=\"medication-admin-status-completed\"> </a>\n                </td>\n                <td>Completed</td>\n                <td>All actions that are implied by the administration have occurred.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">entered-in-error\n                  <a name=\"medication-admin-status-entered-in-error\"> </a>\n                </td>\n                <td>Entered in Error</td>\n                <td>The administration was entered in error and therefore nullified.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">stopped\n                  <a name=\"medication-admin-status-stopped\"> </a>\n                </td>\n                <td>Stopped</td>\n                <td>Actions implied by the administration have been permanently halted, before all of them occurred.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">unknown\n                  <a name=\"medication-admin-status-unknown\"> </a>\n                </td>\n                <td>Unknown</td>\n                <td>The authoring system does not know which of the status values currently applies for this request. Note: This concept is not to be used for 'other' - one of the listed statuses is presumed to apply, it's just not known which one.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:code ;
       fhir:v "phx"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/CodeSystem/medication-admin-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/CodeSystem/medication-admin-status>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.4.2000" ]
  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "MedicationAdministrationStatusCodes"] ; # 
  fhir:title [ fhir:v "MedicationAdministration Status Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International"] ; # 
  fhir:description [ fhir:v "MedicationAdministration Status Codes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/medication-admin-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/medication-admin-status>
  ] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "in-progress" ] ;
     fhir:display [ fhir:v "In Progress" ] ;
     fhir:definition [ fhir:v "The administration has started but has not yet completed." ]
  ] [
     fhir:code [ fhir:v "not-done" ] ;
     fhir:display [ fhir:v "Not Done" ] ;
     fhir:definition [ fhir:v "The administration was terminated prior to any impact on the subject (though preparatory actions may have been taken)" ]
  ] [
     fhir:code [ fhir:v "on-hold" ] ;
     fhir:display [ fhir:v "On Hold" ] ;
     fhir:definition [ fhir:v "Actions implied by the administration have been temporarily halted, but are expected to continue later. May also be called 'suspended'." ]
  ] [
     fhir:code [ fhir:v "completed" ] ;
     fhir:display [ fhir:v "Completed" ] ;
     fhir:definition [ fhir:v "All actions that are implied by the administration have occurred." ]
  ] [
     fhir:code [ fhir:v "entered-in-error" ] ;
     fhir:display [ fhir:v "Entered in Error" ] ;
     fhir:definition [ fhir:v "The administration was entered in error and therefore nullified." ]
  ] [
     fhir:code [ fhir:v "stopped" ] ;
     fhir:display [ fhir:v "Stopped" ] ;
     fhir:definition [ fhir:v "Actions implied by the administration have been permanently halted, before all of them occurred." ]
  ] [
     fhir:code [ fhir:v "unknown" ] ;
     fhir:display [ fhir:v "Unknown" ] ;
     fhir:definition [ fhir:v "The authoring system does not know which of the status values currently applies for this request. Note: This concept is not to be used for 'other' - one of the listed statuses is presumed to apply, it's just not known which one." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/reason-medication-not-given-codes> a fhir:CodeSystem ;
  fhir:id [ fhir:v "reason-medication-not-given-codes"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/shareablecodesystem>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/reason-medication-not-given</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">a\n                  <a name=\"reason-medication-not-given-codes-a\"> </a>\n                </td>\n                <td>None</td>\n                <td>No reason known.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">b\n                  <a name=\"reason-medication-not-given-codes-b\"> </a>\n                </td>\n                <td>Away</td>\n                <td>The patient was not available when the dose was scheduled.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">c\n                  <a name=\"reason-medication-not-given-codes-c\"> </a>\n                </td>\n                <td>Asleep</td>\n                <td>The patient was asleep when the dose was scheduled.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">d\n                  <a name=\"reason-medication-not-given-codes-d\"> </a>\n                </td>\n                <td>Vomit</td>\n                <td>The patient was given the medication and immediately vomited it back.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:code ;
       fhir:v "phx"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/reason-medication-not-given"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/reason-medication-not-given>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
