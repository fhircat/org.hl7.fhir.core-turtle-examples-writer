  ] [
     fhir:code [ fhir:v "error" ] ;
     fhir:display [ fhir:v "Error" ] ;
     fhir:definition [ fhir:v "The issue is sufficiently important to cause the action to fail." ]
  ] [
     fhir:code [ fhir:v "warning" ] ;
     fhir:display [ fhir:v "Warning" ] ;
     fhir:definition [ fhir:v "The issue is not important enough to cause the action to fail but may cause it to be performed suboptimally or in a way that is not as desired." ]
  ] [
     fhir:code [ fhir:v "information" ] ;
     fhir:display [ fhir:v "Information" ] ;
     fhir:definition [ fhir:v "The issue has no relation to the degree of success of the action." ]
  ] [
