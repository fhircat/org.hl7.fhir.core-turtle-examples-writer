<http://hl7.org/fhir/CodeSystem/udi-entry-type> a fhir:CodeSystem ;
  fhir:id [ fhir:v "udi-entry-type"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
