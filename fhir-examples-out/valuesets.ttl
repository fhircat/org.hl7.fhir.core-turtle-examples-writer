<http://hl7.org/fhir/CodeSystem/allergy-intolerance-category> a fhir:CodeSystem ;
  fhir:id [ fhir:v "allergy-intolerance-category"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
