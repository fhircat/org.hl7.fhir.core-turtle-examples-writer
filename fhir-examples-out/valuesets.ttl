  ] [
     fhir:code [ fhir:v "agency" ] ;
     fhir:display [ fhir:v "Agency" ] ;
     fhir:definition [ fhir:v "An organization such as a public health agency, community/social services provider, etc." ]
  ] [
     fhir:code [ fhir:v "research" ] ;
