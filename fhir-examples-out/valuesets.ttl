  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/CodeSystem/medication-statement-status</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">recorded\n                  <a name=\"medication-statement-status-recorded\"> </a>\n                </td>\n                <td>Recorded</td>\n                <td>The action of recording the medication statement is finished.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">entered-in-error\n                  <a name=\"medication-statement-status-entered-in-error\"> </a>\n                </td>\n                <td>Entered in Error</td>\n                <td>Some of the actions that are implied by the medication usage may have occurred.  For example, the patient may have taken some of the medication.  Clinical decision support systems should take this status into account.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">draft\n                  <a name=\"medication-statement-status-draft\"> </a>\n                </td>\n                <td>Draft</td>\n                <td>The medication usage is draft or preliminary.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
