  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "DeviceDispenseStatusReasonCodes"] ; # 
  fhir:title [ fhir:v "DeviceDispense Status Reason Codes"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
