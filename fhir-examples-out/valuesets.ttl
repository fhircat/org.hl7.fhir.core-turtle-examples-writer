  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/animal-tissue-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072091\n                  <a name=\"animal-tissue-type-100000072091\"> </a>\n                </td>\n                <td>All relevant tissues</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072092\n                  <a name=\"animal-tissue-type-100000072092\"> </a>\n                </td>\n                <td>Fat</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072093\n                  <a name=\"animal-tissue-type-100000072093\"> </a>\n                </td>\n                <td>Honey</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072094\n                  <a name=\"animal-tissue-type-100000072094\"> </a>\n                </td>\n                <td>Liver</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072095\n                  <a name=\"animal-tissue-type-100000072095\"> </a>\n                </td>\n                <td>Fresh Milk</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072096\n                  <a name=\"animal-tissue-type-100000072096\"> </a>\n                </td>\n                <td>Muscle and skin in natural proportions</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072104\n                  <a name=\"animal-tissue-type-100000072104\"> </a>\n                </td>\n                <td>Eggs</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072105\n                  <a name=\"animal-tissue-type-100000072105\"> </a>\n                </td>\n                <td>Skin and fat</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072106\n                  <a name=\"animal-tissue-type-100000072106\"> </a>\n                </td>\n                <td>Kidney</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072107\n                  <a name=\"animal-tissue-type-100000072107\"> </a>\n                </td>\n                <td>Meat and offal</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072108\n                  <a name=\"animal-tissue-type-100000072108\"> </a>\n                </td>\n                <td>Muscle</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000072109\n                  <a name=\"animal-tissue-type-100000072109\"> </a>\n                </td>\n                <td>Unspecified</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111053\n                  <a name=\"animal-tissue-type-100000111053\"> </a>\n                </td>\n                <td>Adipose tissue</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111054\n                  <a name=\"animal-tissue-type-100000111054\"> </a>\n                </td>\n                <td>Adrenal</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111055\n                  <a name=\"animal-tissue-type-100000111055\"> </a>\n                </td>\n                <td>Blood vessels</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111056\n                  <a name=\"animal-tissue-type-100000111056\"> </a>\n                </td>\n                <td>Bone</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111057\n                  <a name=\"animal-tissue-type-100000111057\"> </a>\n                </td>\n                <td>Bone marrow</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111058\n                  <a name=\"animal-tissue-type-100000111058\"> </a>\n                </td>\n                <td>Brain</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111059\n                  <a name=\"animal-tissue-type-100000111059\"> </a>\n                </td>\n                <td>Connective tissue</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111060\n                  <a name=\"animal-tissue-type-100000111060\"> </a>\n                </td>\n                <td>Cornea</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111061\n                  <a name=\"animal-tissue-type-100000111061\"> </a>\n                </td>\n                <td>Dental pulp</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111062\n                  <a name=\"animal-tissue-type-100000111062\"> </a>\n                </td>\n                <td>Duodenum</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111063\n                  <a name=\"animal-tissue-type-100000111063\"> </a>\n                </td>\n                <td>Dura mater</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111064\n                  <a name=\"animal-tissue-type-100000111064\"> </a>\n        