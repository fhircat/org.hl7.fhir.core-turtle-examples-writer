  ] ) ; # 
  fhir:description [ fhir:v "Indicates whether the account is available to be used for billing purposes."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
