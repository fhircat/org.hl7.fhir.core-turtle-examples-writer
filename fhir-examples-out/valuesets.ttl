  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <ul>\n              <li>Include these codes as defined in \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/281323002\">281323002</a>\n                    </td>\n                    <td>Insufficient requesting detail</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/397709008\">397709008</a>\n                    </td>\n                    <td>Patient died (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/105480006\">105480006</a>\n                    </td>\n                    <td>Refusal of treatment by patient</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/719500002\">719500002</a>\n                    </td>\n                    <td>Left care setting having refused treatment (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/445060000\">445060000</a>\n                    </td>\n                    <td>Left against medical advice (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/704273008\">704273008</a>\n                    </td>\n                    <td>Consent declined for examination of cardiovascular system</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/704274002\">704274002</a>\n                    </td>\n                    <td>Consent declined for examination of central nervous system (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/704458005\">704458005</a>\n                    </td>\n                    <td>Consent declined for examination of gastrointestinal system (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/704275001\">704275001</a>\n                    </td>\n                    <td>Consent declined for examination of genitourinary system</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/704276000\">704276000</a>\n                    </td>\n                    <td>Consent declined for examination of musculoskeletal system</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/704277009\">704277009</a>\n                    </td>\n                    <td>Consent declined for examination of respiratory system</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/310376006\">310376006</a>\n                    </td>\n                    <td>Immunization consent not given</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/414859005\">414859005</a>\n                    </td>\n                    <td>No consent for electronic record sharing (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/416409005\">416409005</a>\n                    </td>\n                    <td>Refused consent for upload to local shared electronic record (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/416308001\">416308001</a>\n                    </td>\n                    <td>Refused consent for upload to national shared electronic record (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/737038009\">737038009</a>\n                    </td>\n                    <td>Declined consent for treatment (finding)</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/713835001\">713835001</a>\n                    </td>\n                    <td>Declined consent for use of patient data in risk stratification for unplanned hospital admission</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/398227009\">398227009</a>\n                    </td>\n                    <td>Inadequate consent (finding)</td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral
