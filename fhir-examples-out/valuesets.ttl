  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/biologicallyderivedproductdispense-match-status</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">crossmatched\n                  <a name=\"biologicallyderivedproductdispense-match-status-crossmatched\"> </a>\n                </td>\n                <td>Crossmatched</td>\n                <td>The product has been serologically or electronically crossmatched for the recipient</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">selected\n                  <a name=\"biologicallyderivedproductdispense-match-status-selected\"> </a>\n                </td>\n                <td>Selected</td>\n                <td>The product has been selected for the specific use of the recipient</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">unmatched\n                  <a name=\"biologicallyderivedproductdispense-match-status-unmatched\"> </a>\n                </td>\n                <td>Unmatched</td>\n                <td>No specific matching has been carried out</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">least-incompatible\n                  <a name=\"biologicallyderivedproductdispense-match-status-least-incompatible\"> </a>\n                </td>\n                <td>least incompatible</td>\n                <td>The product has been selected through crossmatching as least incompatible</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
