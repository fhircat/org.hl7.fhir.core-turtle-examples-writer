  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/inventoryreport-counttype</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">snapshot\n                  <a name=\"inventoryreport-counttype-snapshot\"> </a>\n                </td>\n                <td>Snapshot</td>\n                <td>The inventory report is a current absolute snapshot, i.e. it represents the quantities at hand.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">difference\n                  <a name=\"inventoryreport-counttype-difference\"> </a>\n                </td>\n                <td>Difference</td>\n                <td>The inventory report is about the difference between a previous count and a current count, i.e. it represents the items that have been added/subtracted from inventory.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
