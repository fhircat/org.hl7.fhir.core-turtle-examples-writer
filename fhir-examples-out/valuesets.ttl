       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:immutable [ fhir:v true] ; # 
  fhir:copyright [ fhir:v "MRI safety definitions reprinted, with permission, from F2503-08 Standard Practice for Marking Medical Devices and Other Items for Safety in the Magnetic Resonance Environment, copyright ASTM International, 100 Barr Harbor Drive, West Conshohocken, PA 19428.  See [ASTM F2503](https://www.astm.org/Standards/F2503.htm)."] ; # 
  fhir:compose [
     fhir:include ( [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-systemName"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-systemName>
         ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "NCI Thesaurus"
         ]
       ] ) ;
       fhir:system [
         fhir:v "urn:oid:2.16.840.1.113883.3.26.1.1"^^xsd:anyURI ;
         fhir:l <urn:oid:2.16.840.1.113883.3.26.1.1>
       ] ;
       fhir:concept ( [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
             a fhir:string ;
             fhir:v "A device with demonstrated safety in the MR environment within defined conditions. At a minimum, address the conditions of the static magnetic field, the switched gradient magnetic field and the radiofrequency fields. Additional conditions, including specific configurations of the item, may be required. See ASTM F2503"
           ]
         ] ) ;
         fhir:code [ fhir:v "C106046" ] ;
         fhir:display [ fhir:v "Magnetic Resonance Conditional" ] ;
         fhir:designation ( [
           fhir:value [ fhir:v "MR Conditional" ]
         ] )
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
             a fhir:string ;
             fhir:v "The device poses no known hazards resulting from exposure to any MR environment. MR Safe items are composed of materials that are electrically nonconductive, nonmetallic, and nonmagnetic. See ASTM F2503"
           ]
         ] ) ;
         fhir:code [ fhir:v "C106045" ] ;
         fhir:display [ fhir:v "Magnetic Resonance Safe" ] ;
         fhir:designation ( [
           fhir:value [ fhir:v "MR Safe" ]
         ] )
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
             a fhir:string ;
             fhir:v "The device which poses unacceptable risks to the patient, medical staff or other persons within the MR environment. See ASTM F2503"
           ]
         ] ) ;
         fhir:code [ fhir:v "C106047" ] ;
         fhir:display [ fhir:v "Magnetic Resonance Unsafe" ] ;
         fhir:designation ( [
           fhir:value [ fhir:v "MR Unsafe" ]
         ] )
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
             a fhir:string ;
             fhir:v "Information on the safety of using a device in a magnetic resonance (MR) environment has not been provided in the labeling by the labeler."
           ]
         ] ) ;
         fhir:code [ fhir:v "C113844" ] ;
         fhir:display [ fhir:v "Labeling does not Contain MRI Safety Information" ]
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
             a fhir:string ;
             fhir:v "The device label indicates natural rubber latex as a component."
           ]
         ] ) ;
         fhir:code [ fhir:v "C101673" ] ;
         fhir:display [ fhir:v "Labeled as Containing Natural Rubber Latex" ]
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
