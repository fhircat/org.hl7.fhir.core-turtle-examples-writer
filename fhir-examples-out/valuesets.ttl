               a fhir:boolean ;
               fhir:v true
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CapabilityStatement" ] ;
           fhir:display [ fhir:v "CapabilityStatement" ] ;
           fhir:definition [ fhir:v "A Capability Statement documents a set of capabilities (behaviors) of a FHIR Server or Client for a particular version of FHIR that may be used as a statement of actual server functionality or a statement of required or desired server implementation." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CarePlan" ] ;
           fhir:display [ fhir:v "CarePlan" ] ;
           fhir:definition [ fhir:v "Describes the intention of how one or more practitioners intend to deliver care for a particular patient, group or community for a period of time, possibly limited to care for a specific condition or set of conditions." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CareTeam" ] ;
           fhir:display [ fhir:v "CareTeam" ] ;
           fhir:definition [ fhir:v "The Care Team includes all the people and organizations who plan to participate in the coordination and delivery of care." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ChargeItem" ] ;
           fhir:display [ fhir:v "ChargeItem" ] ;
           fhir:definition [ fhir:v "The resource ChargeItem describes the provision of healthcare provider products for a certain patient, therefore referring not only to the product, but containing in addition details of the provision, like date, time, amounts and participating organizations and persons. Main Usage of the ChargeItem is to enable the billing process and internal cost allocation." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ChargeItemDefinition" ] ;
           fhir:display [ fhir:v "ChargeItemDefinition" ] ;
           fhir:definition [ fhir:v "The ChargeItemDefinition resource provides the properties that apply to the (billing) codes necessary to calculate costs and prices. The properties may differ largely depending on type and realm, therefore this resource gives only a rough structure and requires profiling for each type of billing code system." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Citation" ] ;
           fhir:display [ fhir:v "Citation" ] ;
           fhir:definition [ fhir:v "The Citation Resource enables reference to any knowledge artifact for purposes of identification and attribution. The Citation Resource supports existing reference structures and developing publication practices such as versioning, expressing complex contributorship roles, and referencing computable resources." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Claim" ] ;
           fhir:display [ fhir:v "Claim" ] ;
           fhir:definition [ fhir:v "A provider issued list of professional services and products which have been provided, or are to be provided, to a patient which is sent to an insurer for reimbursement." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ClaimResponse" ] ;
           fhir:display [ fhir:v "ClaimResponse" ] ;
           fhir:definition [ fhir:v "This resource provides the adjudication details from the processing of a Claim resource." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ClinicalImpression" ] ;
           fhir:display [ fhir:v "ClinicalImpression" ] ;
           fhir:definition [ fhir:v "A record of a clinical assessment performed to determine what problem(s) may affect the patient and before planning the treatments or management strategies that are best to manage a patient's condition. Assessments are often 1:1 with a clinical consultation / encounter,  but this varies greatly depending on the clinical workflow. This resource is called \"ClinicalImpression\" rather than \"ClinicalAssessment\" to avoid confusion with the recording of assessment tools such as Apgar score." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ClinicalUseDefinition" ] ;
           fhir:display [ fhir:v "ClinicalUseDefinition" ] ;
           fhir:definition [ fhir:v "A single issue - either an indication, contraindication, interaction or an undesirable effect for a medicinal product, medication, device or procedure." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CodeSystem" ] ;
           fhir:display [ fhir:v "CodeSystem" ] ;
           fhir:definition [ fhir:v "The CodeSystem resource is used to declare the existence of and describe a code system or code system supplement and its key properties, and optionally define a part or all of its content." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Communication" ] ;
           fhir:display [ fhir:v "Communication" ] ;
           fhir:definition [ fhir:v "A clinical or business level record of information being transmitted or shared; e.g. an alert that was sent to a responsible provider, a public health agency communication to a provider/reporter in response to a case report for a reportable condition." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CommunicationRequest" ] ;
           fhir:display [ fhir:v "CommunicationRequest" ] ;
           fhir:definition [ fhir:v "A request to convey information; e.g. the CDS system proposes that an alert be sent to a responsible provider, the CDS system proposes that the public health agency be notified about a reportable condition." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CompartmentDefinition" ] ;
           fhir:display [ fhir:v "CompartmentDefinition" ] ;
           fhir:definition [ fhir:v "A compartment definition that defines how resources are accessed on a server." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Composition" ] ;
           fhir:display [ fhir:v "Composition" ] ;
           fhir:definition [ fhir:v "A set of healthcare-related information that is assembled together into a single logical package that provides a single coherent statement of meaning, establishes its own context and that has clinical attestation with regard to who is making the statement. A Composition defines the structure and narrative content necessary for a document. However, a Composition alone does not constitute a document. Rather, the Composition must be the first entry in a Bundle where Bundle.type=document, and any other resources referenced from Composition must be included as subsequent entries in the Bundle (for example Patient, Practitioner, Encounter, etc.)." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ConceptMap" ] ;
           fhir:display [ fhir:v "ConceptMap" ] ;
           fhir:definition [ fhir:v "A statement of relationships from one set of concepts to one or more other concepts - either concepts in code systems, or data element/data element concepts, or classes in class models." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Condition" ] ;
           fhir:display [ fhir:v "Condition" ] ;
           fhir:definition [ fhir:v "A clinical condition, problem, diagnosis, or other event, situation, issue, or clinical concept that has risen to a level of concern." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ConditionDefinition" ] ;
           fhir:display [ fhir:v "ConditionDefinition" ] ;
           fhir:definition [ fhir:v "A definition of a condition and information relevant to managing it." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Consent" ] ;
           fhir:display [ fhir:v "Consent" ] ;
           fhir:definition [ fhir:v "A record of a healthcare consumer’s  choices  or choices made on their behalf by a third party, which permits or denies identified recipient(s) or recipient role(s) to perform one or more actions within a given policy context, for specific purposes and periods of time." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Contract" ] ;
           fhir:display [ fhir:v "Contract" ] ;
           fhir:definition [ fhir:v "Legally enforceable, formally recorded unilateral or bilateral directive i.e., a policy or agreement." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Coverage" ] ;
           fhir:display [ fhir:v "Coverage" ] ;
           fhir:definition [ fhir:v "Financial instrument which may be used to reimburse or pay for health care products and services. Includes both insurance and self-payment." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CoverageEligibilityRequest" ] ;
           fhir:display [ fhir:v "CoverageEligibilityRequest" ] ;
           fhir:definition [ fhir:v "The CoverageEligibilityRequest provides patient and insurance coverage information to an insurer for them to respond, in the form of an CoverageEligibilityResponse, with information regarding whether the stated coverage is valid and in-force and optionally to provide the insurance details of the policy." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CoverageEligibilityResponse" ] ;
           fhir:display [ fhir:v "CoverageEligibilityResponse" ] ;
           fhir:definition [ fhir:v "This resource provides eligibility and plan details from the processing of an CoverageEligibilityRequest resource." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DetectedIssue" ] ;
           fhir:display [ fhir:v "DetectedIssue" ] ;
           fhir:definition [ fhir:v "Indicates an actual or potential clinical issue with or between one or more active or proposed clinical actions for a patient; e.g. Drug-drug interaction, Ineffective treatment frequency, Procedure-condition conflict, gaps in care, etc." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Device" ] ;
           fhir:display [ fhir:v "Device" ] ;
           fhir:definition [ fhir:v "This resource describes the properties (regulated, has real time clock, etc.), adminstrative (manufacturer name, model number, serial number, firmware, etc.), and type (knee replacement, blood pressure cuff, MRI, etc.) of a physical unit (these values do not change much within a given module, for example the serail number, manufacturer name, and model number). An actual unit may consist of several modules in a distinct hierarchy and these are represented by multiple Device resources and bound through the 'parent' element." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DeviceAssociation" ] ;
           fhir:display [ fhir:v "DeviceAssociation" ] ;
           fhir:definition [ fhir:v "A record of association of a device." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DeviceDefinition" ] ;
           fhir:display [ fhir:v "DeviceDefinition" ] ;
           fhir:definition [ fhir:v "This is a specialized resource that defines the characteristics and capabilities of a device." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DeviceDispense" ] ;
           fhir:display [ fhir:v "DeviceDispense" ] ;
           fhir:definition [ fhir:v "Indicates that a device is to be or has been dispensed for a named person/patient.  This includes a description of the product (supply) provided and the instructions for using the device." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DeviceMetric" ] ;
           fhir:display [ fhir:v "DeviceMetric" ] ;
           fhir:definition [ fhir:v "Describes a measurement, calculation or setting capability of a device.  The DeviceMetric resource is derived from the ISO/IEEE 11073-10201 Domain Information Model standard, but is more widely applicable. " ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DeviceRequest" ] ;
           fhir:display [ fhir:v "DeviceRequest" ] ;
           fhir:definition [ fhir:v "Represents a request a device to be provided to a specific patient. The device may be an implantable device to be subsequently implanted, or an external assistive device, such as a walker, to be delivered and subsequently be used." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DeviceUsage" ] ;
           fhir:display [ fhir:v "DeviceUsage" ] ;
           fhir:definition [ fhir:v "A record of a device being used by a patient where the record is the result of a report from the patient or a clinician." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DiagnosticReport" ] ;
           fhir:display [ fhir:v "DiagnosticReport" ] ;
           fhir:definition [ fhir:v "The findings and interpretation of diagnostic tests performed on patients, groups of patients, products, substances, devices, and locations, and/or specimens derived from these. The report includes clinical context such as requesting provider information, and some mix of atomic results, images, textual and coded interpretations, and formatted representation of diagnostic reports. The report also includes non-clinical context such as batch analysis and stability reporting of products and substances." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DocumentReference" ] ;
           fhir:display [ fhir:v "DocumentReference" ] ;
           fhir:definition [ fhir:v "A reference to a document of any kind for any purpose. While the term “document” implies a more narrow focus, for this resource this “document” encompasses *any* serialized object with a mime-type, it includes formal patient-centric documents (CDA), clinical notes, scanned paper, non-patient specific documents like policy text, as well as a photo, video, or audio recording acquired or used in healthcare.  The DocumentReference resource provides metadata about the document so that the document can be discovered and managed.  The actual content may be inline base64 encoded data or provided by direct reference." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Encounter" ] ;
           fhir:display [ fhir:v "Encounter" ] ;
           fhir:definition [ fhir:v "An interaction between healthcare provider(s), and/or patient(s) for the purpose of providing healthcare service(s) or assessing the health status of patient(s)." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EncounterHistory" ] ;
           fhir:display [ fhir:v "EncounterHistory" ] ;
           fhir:definition [ fhir:v "A record of significant events/milestones key data throughout the history of an Encounter" ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Endpoint" ] ;
           fhir:display [ fhir:v "Endpoint" ] ;
           fhir:definition [ fhir:v "The technical details of an endpoint that can be used for electronic services, such as for web services providing XDS.b, a REST endpoint for another FHIR server, or a s/Mime email address. This may include any security context information." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EnrollmentRequest" ] ;
           fhir:display [ fhir:v "EnrollmentRequest" ] ;
           fhir:definition [ fhir:v "This resource provides the insurance enrollment details to the insurer regarding a specified coverage." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EnrollmentResponse" ] ;
           fhir:display [ fhir:v "EnrollmentResponse" ] ;
           fhir:definition [ fhir:v "This resource provides enrollment and plan details from the processing of an EnrollmentRequest resource." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EpisodeOfCare" ] ;
           fhir:display [ fhir:v "EpisodeOfCare" ] ;
           fhir:definition [ fhir:v "An association between a patient and an organization / healthcare provider(s) during which time encounters may occur. The managing organization assumes a level of responsibility for the patient during this time." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EventDefinition" ] ;
           fhir:display [ fhir:v "EventDefinition" ] ;
           fhir:definition [ fhir:v "The EventDefinition resource provides a reusable description of when a particular event can occur." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Evidence" ] ;
           fhir:display [ fhir:v "Evidence" ] ;
           fhir:definition [ fhir:v "The Evidence Resource provides a machine-interpretable expression of an evidence concept including the evidence variables (e.g., population, exposures/interventions, comparators, outcomes, measured variables, confounding variables), the statistics, and the certainty of this evidence." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EvidenceReport" ] ;
           fhir:display [ fhir:v "EvidenceReport" ] ;
           fhir:definition [ fhir:v "The EvidenceReport Resource is a specialized container for a collection of resources and codeable concepts, adapted to support compositions of Evidence, EvidenceVariable, and Citation resources and related concepts." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "EvidenceVariable" ] ;
           fhir:display [ fhir:v "EvidenceVariable" ] ;
           fhir:definition [ fhir:v "The EvidenceVariable resource describes an element that knowledge (Evidence) is about." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ExampleScenario" ] ;
           fhir:display [ fhir:v "ExampleScenario" ] ;
           fhir:definition [ fhir:v "A walkthrough of a workflow showing the interaction between systems and the instances shared, possibly including the evolution of instances over time." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ExplanationOfBenefit" ] ;
