     fhir:v "http://hl7.org/fhir/CodeSystem/medicationdispense-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/CodeSystem/medicationdispense-status>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
