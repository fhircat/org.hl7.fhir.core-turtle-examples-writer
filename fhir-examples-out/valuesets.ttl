  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/graph-compartment-rule</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">identical\n                  <a name=\"graph-compartment-rule-identical\"> </a>\n                </td>\n                <td>Identical</td>\n                <td>The compartment must be identical (the same literal reference).</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">matching\n                  <a name=\"graph-compartment-rule-matching\"> </a>\n                </td>\n                <td>Matching</td>\n                <td>The compartment must be the same - the record must be about the same patient, but the reference may be different.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">different\n                  <a name=\"graph-compartment-rule-different\"> </a>\n                </td>\n                <td>Different</td>\n                <td>The compartment must be different.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">custom\n                  <a name=\"graph-compartment-rule-custom\"> </a>\n                </td>\n                <td>Custom</td>\n                <td>The compartment rule is defined in the accompanying FHIRPath expression.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
