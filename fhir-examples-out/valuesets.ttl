     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/reference-version-rules</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">either\n                  <a name=\"reference-version-rules-either\"> </a>\n                </td>\n                <td>Either Specific or independent</td>\n                <td>The reference may be either version independent or version specific.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">independent\n                  <a name=\"reference-version-rules-independent\"> </a>\n                </td>\n                <td>Version independent</td>\n                <td>The reference must be version independent.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">specific\n                  <a name=\"reference-version-rules-specific\"> </a>\n                </td>\n                <td>Version Specific</td>\n                <td>The reference must be version specific.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
