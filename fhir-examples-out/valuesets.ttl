  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/search-entry-mode</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n                <td>\n                  <b>Deprecated</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">match\n                  <a name=\"search-entry-mode-match\"> </a>\n                </td>\n                <td>Match</td>\n                <td>This resource matched the search specification.</td>\n                <td/>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">include\n                  <a name=\"search-entry-mode-include\"> </a>\n                </td>\n                <td>Include</td>\n                <td>This resource is returned because it is referred to from another resource in the search set.</td>\n                <td/>\n              </tr>\n              <tr style=\"background-color: #ffeeee\">\n                <td style=\"white-space:nowrap\">outcome\n                  <a name=\"search-entry-mode-outcome\"> </a>\n                </td>\n                <td>Outcome</td>\n                <td>An OperationOutcome that provides additional information about the processing of a search.</td>\n                <td>Deprecated\n                  <div>\n                    <p>Use Bundle.issues instead</p>\n\n                  </div>\n                </td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
