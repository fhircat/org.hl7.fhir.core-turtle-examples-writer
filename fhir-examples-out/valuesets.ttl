     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/research-study-party-role</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sponsor\n                  <a name=\"research-study-party-role-sponsor\"> </a>\n                </td>\n                <td>sponsor</td>\n                <td>sponsor</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">lead-sponsor\n                  <a name=\"research-study-party-role-lead-sponsor\"> </a>\n                </td>\n                <td>lead-sponsor</td>\n                <td>lead-sponsor</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sponsor-investigator\n                  <a name=\"research-study-party-role-sponsor-investigator\"> </a>\n                </td>\n                <td>sponsor-investigator</td>\n                <td>sponsor-investigator</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">primary-investigator\n                  <a name=\"research-study-party-role-primary-investigator\"> </a>\n                </td>\n                <td>primary-investigator</td>\n                <td>primary-investigator</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">collaborator\n                  <a name=\"research-study-party-role-collaborator\"> </a>\n                </td>\n                <td>collaborator</td>\n                <td>collaborator</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">funding-source\n                  <a name=\"research-study-party-role-funding-source\"> </a>\n                </td>\n                <td>funding-source</td>\n                <td>funding-source</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">general-contact\n                  <a name=\"research-study-party-role-general-contact\"> </a>\n                </td>\n                <td>general-contact</td>\n                <td>general-contact</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">recruitment-contact\n                  <a name=\"research-study-party-role-recruitment-contact\"> </a>\n                </td>\n                <td>recruitment-contact</td>\n                <td>recruitment-contact</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sub-investigator\n                  <a name=\"research-study-party-role-sub-investigator\"> </a>\n                </td>\n                <td>sub-investigator</td>\n                <td>sub-investigator</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">study-director\n                  <a name=\"research-study-party-role-study-director\"> </a>\n                </td>\n                <td>study-director</td>\n                <td>study-director</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">study-chair\n                  <a name=\"research-study-party-role-study-chair\"> </a>\n                </td>\n                <td>study-chair</td>\n                <td>study-chair</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">irb\n                  <a name=\"research-study-party-role-irb\"> </a>\n                </td>\n                <td>Institutional Review Board</td>\n                <td/