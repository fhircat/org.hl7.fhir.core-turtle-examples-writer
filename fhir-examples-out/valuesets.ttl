  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/evidence-report-section</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Evidence\n                  <a name=\"evidence-report-section-Evidence\"> </a>\n                </td>\n                <td>Evidence Results</td>\n                <td>Evidence Results.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Intervention-group-alone-Evidence\n                  <a name=\"evidence-report-section-Intervention-group-alone-Evidence\"> </a>\n                </td>\n                <td>Evidence Results for the intervention exposure only</td>\n                <td>Evidence Results for the intervention exposure only.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Intervention-vs-Control-Evidence\n                  <a name=\"evidence-report-section-Intervention-vs-Control-Evidence\"> </a>\n                </td>\n                <td>Evidence Results for comparison of Intervention and Control</td>\n                <td>Evidence Results for comparison of Intervention and Control.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Control-group-alone-Evidence\n                  <a name=\"evidence-report-section-Control-group-alone-Evidence\"> </a>\n                </td>\n                <td>Evidence Results for the control exposure only</td>\n                <td>Evidence Results for the control exposure only.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">EvidenceVariable\n                  <a name=\"evidence-report-section-EvidenceVariable\"> </a>\n                </td>\n                <td>Evidence Variables used</td>\n                <td>Evidence Variables used.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">EvidenceVariable-observed\n                  <a name=\"evidence-report-section-EvidenceVariable-observed\"> </a>\n                </td>\n                <td>Evidence Variables actually observed</td>\n                <td>Evidence Variables as observed in the research data.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">EvidenceVariable-intended\n                  <a name=\"evidence-report-section-EvidenceVariable-intended\"> </a>\n                </td>\n                <td>Evidence Variables intended for interpretation</td>\n                <td>Evidence Variables intended for interpretation.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">EvidenceVariable-population\n                  <a name=\"evidence-report-section-EvidenceVariable-population\"> </a>\n                </td>\n                <td>Evidence Variable in variable role Population</td>\n                <td>Evidence Variable in variable role Population.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">EvidenceVariable-exposure\n                  <a name=\"evidence-report-section-EvidenceVariable-exposure\"> </a>\n                </td>\n                <td>Evidence Variable in variable role Exposure</td>\n                <td>Evidence Variable in variable role Exposure.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">EvidenceVariable-outcome\n                  <a name=\"evidence-report-section-EvidenceVariable-outcome\"> </a>\n                </td>\n                <td>Evidence Variable in variable role Outcome (MeasuredVariable)</td>\n                <td>Evidence Variable in variable role Outcome (MeasuredVariable).</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Efficacy-outcomes\n                  <a name=\"evidence-report-section-Efficacy-outcomes\"> </a>\n                </td>\n                <td>Efficacy-outcomes</td>\n                <td>Outcomes related to efficacy or potential benefits of interventions.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Harms-outcomes\n                  <a name=\"evidence-report-section-Harms-outcomes\"> </a>\n                </td>\n                <td>Harms outcomes</td>\n                <td>Outcomes related to adverse effects or potential harms of interventions.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">SampleSize\n                  <a name=\"evidence-report-section-SampleSize\"> </a>\n                </td>\n                <td>Sample Size</td>\n                <td>Sample Size.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">References\n                  <a name=\"evidence-report-section-References\"> </a>\n                </td>\n                <td>References</td>\n                <td>References.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Assertion\n                  <a name=\"evidence-report-section-Assertion\"> </a>\n                </td>\n                <td>Assertion</td>\n                <td>Assertion.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Reasons\n                  <a name=\"evidence-report-section-Reasons\"> </a>\n                </td>\n                <td>Reasons</td>\n                <td>Reasons.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Certainty-of-Evidence\n                  <a name=\"evidence-report-section-Certainty-of-Evidence\"> </a>\n                </td>\n                <td>Certainty of Evidence</td>\n                <td>Certainty of Evidence.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Evidence-Classifier\n                  <a name=\"evidence-report-section-Evidence-Classifier\"> </a>\n                </td>\n                <td>Evidence Classifier section</td>\n                <td>This section is used for classifiers of the evidence.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Warnings\n                  <a name=\"evidence-report-section-Warnings\"> </a>\n                </td>\n                <td>Warnings</td>\n                <td>Warnings.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Text-Summary\n                  <a name=\"evidence-report-section-Text-Summary\"> </a>\n                </td>\n                <td>Text Summary</td>\n                <td>Denotes a section specifying text summary for a report.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">SummaryOfBodyOfEvidenceFindings\n                  <a name=\"evidence-report-section-SummaryOfBodyOfEvidenceFindings\"> </a>\n                </td>\n                <td>Summary of Body of Evidence Findings</td>\n                <td>Summary of Body of Evidence Findings.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">SummaryOfIndividualStudyFindings\n                  <a name=\"evidence-report-section-SummaryOfIndividualStudyFindings\"> </a>\n                </td>\n                <td>Summary of Individual Study Findings</td>\n                <td>Summary of Individual Study Findings.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Header\n                  <a name=\"evidence-report-section-Header\"> </a>\n                </td>\n                <td>Header</td>\n                <td>Denotes the header to use for a Text Summary or above a Table.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Tables\n                  <a name=\"evidence-report-section-Tables\"> </a>\n                </td>\n                <td>Tables</td>\n                <td>Tables.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Table\n                  <a name=\"evidence-report-section-Table\"> </a>\n                </td>\n                <td>Table</td>\n                <td/>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Row-Headers\n                  <a name=\"evidence-report-section-Row-Headers\"> </a>\n                </td>\n                <td>Row Headers</td>\n                <td>Denotes a section specifying row headers for a tabular report.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Column-Header\n                  <a name=\"evidence-report-section-Column-Header\"> </a>\n                </td>\n                <td>Column Header</td>\n                <td>Denotes the header to use for the column for a tabular report.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Column-Headers\n                  <a name=\"evidence-report-section-Column-Headers\"> </a>\n                </td>\n                <td>Column Headers</td>\n                <td>Denotes a section specifying column headers for a tabular report.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
