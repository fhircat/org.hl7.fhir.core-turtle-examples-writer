     fhir:definition [ fhir:v "The patient is the spouse or equivalent of the subscriber (policy holder)" ]
  ] [
     fhir:code [ fhir:v "3" ] ;
     fhir:display [ fhir:v "Child" ] ;
     fhir:definition [ fhir:v "The patient is the child of the subscriber (policy holder)" ]
  ] [
     fhir:code [ fhir:v "4" ] ;
     fhir:display [ fhir:v "Common Law Spouse" ] ;
     fhir:definition [ fhir:v "The patient is the common law spouse of the subscriber (policy holder)" ]
  ] [
     fhir:code [ fhir:v "5" ] ;
     fhir:display [ fhir:v "Other" ] ;
     fhir:definition [ fhir:v "The patient has some other relationship, such as parent, to the subscriber (policy holder)" ]
  ] ) . # 

