  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/guide-page-generation</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">html\n                  <a name=\"guide-page-generation-html\"> </a>\n                </td>\n                <td>HTML</td>\n                <td>Page is proper xhtml with no templating.  Will be brought across unchanged for standard post-processing.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">markdown\n                  <a name=\"guide-page-generation-markdown\"> </a>\n                </td>\n                <td>Markdown</td>\n                <td>Page is markdown with templating.  Will use the template to create a file that imports the markdown file prior to post-processing.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">xml\n                  <a name=\"guide-page-generation-xml\"> </a>\n                </td>\n                <td>XML</td>\n                <td>Page is xml with templating.  Will use the template to create a file that imports the source file and run the nominated XSLT transform (see parameters) if present prior to post-processing.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">generated\n                  <a name=\"guide-page-generation-generated\"> </a>\n                </td>\n                <td>Generated</td>\n                <td>Page will be generated by the publication process - no source to bring across.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
