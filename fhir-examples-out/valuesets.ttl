     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <ul>\n              <li>Include these codes as defined in \n                <a href=\"codesystem-medication-admin-status.html\">\n                  <code>http://hl7.org/fhir/CodeSystem/medication-admin-status</code>\n                </a>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                    <td>\n                      <b>Definition</b>\n                    </td>\n                    <td>\n                      <b>\n                        <a href=\"valueset-resource-status.html\">Canonical Mapping for \"Immunization Evaluation Status Codes\"</a>\n                      </b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"codesystem-medication-admin-status.html#medication-admin-status-completed\">completed</a>\n                    </td>\n                    <td>Completed</td>\n                    <td>All actions that are implied by the administration have occurred.</td>\n                    <td>\n                      <span title=\"EQUIVALENT\">~</span>\n                      <a href=\"codesystem-resource-status.html#resource-status-complete\">complete</a>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"codesystem-medication-admin-status.html#medication-admin-status-entered-in-error\">entered-in-error</a>\n                    </td>\n                    <td>Entered in Error</td>\n                    <td>The administration was entered in error and therefore nullified.</td>\n                    <td>\n                      <span title=\"EQUIVALENT\">~</span>\n                      <a href=\"codesystem-resource-status.html#resource-status-error\">error</a>\n                    </td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
