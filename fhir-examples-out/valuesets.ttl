     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/resource-status"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/resource-status>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
