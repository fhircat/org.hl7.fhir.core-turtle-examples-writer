  fhir:name [ fhir:v "ObservationStatus"] ; # 
  fhir:title [ fhir:v "Observation Status"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2021-01-05T10:01:24+11:00"^^xsd:dateTime] ; # 
