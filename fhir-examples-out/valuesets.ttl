     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/deviceassociation-status-reason</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">attached\n                  <a name=\"deviceassociation-status-reason-attached\"> </a>\n                </td>\n                <td>Attached</td>\n                <td>The device is connected to the patient.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">disconnected\n                  <a name=\"deviceassociation-status-reason-disconnected\"> </a>\n                </td>\n                <td>Disconnected</td>\n                <td>The device is no longer connected.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">failed\n                  <a name=\"deviceassociation-status-reason-failed\"> </a>\n                </td>\n                <td>Failed</td>\n                <td>The device has failed to work, or continue to function.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">placed\n                  <a name=\"deviceassociation-status-reason-placed\"> </a>\n                </td>\n                <td>placed</td>\n                <td>The device was placed in the patient.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">replaced\n                  <a name=\"deviceassociation-status-reason-replaced\"> </a>\n                </td>\n                <td>Replaced</td>\n                <td>The device was updated with a new device or device part.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
