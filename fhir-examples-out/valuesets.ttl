     fhir:v "http://hl7.org/fhir/ValueSet/restful-interaction"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/restful-interaction>
  ] ; # 
  fhir:hierarchyMeaning [ fhir:v "is-a"] ; # 
