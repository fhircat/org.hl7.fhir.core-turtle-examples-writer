  fhir:concept ( [
     fhir:code [ fhir:v "SEVCO:01001" ] ;
     fhir:display [ fhir:v "Interventional research" ] ;
     fhir:definition [ fhir:v "A study design in which an independent variable (an exposure or intervention) is prospectively assigned or modified by the investigator to evaluate a response in the dependent variable (an effect or outcome)." ] ;
     fhir:designation ( [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Interventional study" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Interventional study design" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "interventional primary research" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "international method of research" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "experimental research" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "experimental study" ]
     ] ) ;
     fhir:concept ( [
       fhir:code [ fhir:v "SEVCO:01003" ] ;
       fhir:display [ fhir:v "randomized assignment" ] ;
       fhir:definition [ fhir:v "An interventional study design in which an independent variable (an exposure or intervention) is prospectively assigned or modified by random chance to separate groups." ] ;
       fhir:designation ( [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Interventional research with randomized assignment" ]
       ] [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Randomized trial" ]
       ] [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Randomized controlled trial" ]
       ] [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "RCT" ]
       ] ) ;
       fhir:concept ( [
         fhir:code [ fhir:v "SEVCO:01006" ] ;
         fhir:display [ fhir:v "simple randomization" ] ;
         fhir:definition [ fhir:v "A randomized assignment in which each participant has the same prespecified likelihood of being assigned to a group as all other participants, independent of the assignment of any other participant." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Unrestricted Randomization" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01007" ] ;
         fhir:display [ fhir:v "stratified randomization" ] ;
         fhir:definition [ fhir:v "A randomized assignment in which participants are stratified into groups based on prognostic variables and then randomized into balanced treatment groups" ]
       ] [
         fhir:code [ fhir:v "SEVCO:01008" ] ;
         fhir:display [ fhir:v "block randomization" ] ;
         fhir:definition [ fhir:v "A randomized assignment in which a pre-specified number of subjects is assigned to a block containing the same pre-specified ratio of group assignments in random order." ]
       ] [
         fhir:code [ fhir:v "SEVCO:01009" ] ;
         fhir:display [ fhir:v "adaptive randomization" ] ;
         fhir:definition [ fhir:v "A randomized assignment in which a participant’s group assignment probability is adjusted based on any factor such that the likelihood of assignment is not the same for all participants." ]
       ] )
     ] [
       fhir:code [ fhir:v "SEVCO:01005" ] ;
       fhir:display [ fhir:v "Non-randomized assignment" ] ;
       fhir:definition [ fhir:v "An interventional study design in which an independent variable (an exposure or intervention) is prospectively assigned or modified by methods other than random chance to separate groups." ] ;
       fhir:designation ( [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Interventional research with non-randomized assignment" ]
       ] ) ;
       fhir:concept ( [
         fhir:code [ fhir:v "SEVCO:01004" ] ;
         fhir:display [ fhir:v "Quasi-Randomized assignment" ] ;
         fhir:definition [ fhir:v "An interventional study design with a method of allocation that is not limited to random chance but is intended to produce similar baseline groups for experimentation." ]
       ] )
     ] [
       fhir:code [ fhir:v "SEVCO:01029" ] ;
       fhir:display [ fhir:v "Clinical trial" ] ;
       fhir:definition [ fhir:v "Interventional research in which one or more healthcare-related actions (i.e., a diagnostic, prognostic, therapeutic, preventive or screening method or intervention) is evaluated for effects on health-related biomedical or behavioral processes and/or outcomes." ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "SEVCO:01041" ] ;
         fhir:display [ fhir:v "Pragmatic clinical trial" ] ;
         fhir:definition [ fhir:v "A clinical trial conducted under conditions of routine clinical practice." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Pragmatic trial" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01038" ] ;
         fhir:display [ fhir:v "Expanded Access study" ] ;
         fhir:definition [ fhir:v "A clinical trial that provides a means for obtaining an experimental drug or device for patients who are not adequately treated by existing therapy, who do not meet the eligibility criteria for enrollment, or who are otherwise unable to participate in another clinical study. " ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Compassionate use trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Compassionate use study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Expanded access trial" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01030" ] ;
         fhir:display [ fhir:v "Phase 1 trial" ] ;
         fhir:definition [ fhir:v "A clinical trial to gather initial evidence in humans to support further investigation of an intervention." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase I trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 1 study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "phase I clinical trial" ]
         ] ) ;
         fhir:concept ( [
           fhir:code [ fhir:v "SEVCO:01031" ] ;
           fhir:display [ fhir:v "Exploratory investigational new drug study" ] ;
           fhir:definition [ fhir:v "A clinical trial that is conducted early in phase 1, involves very limited human exposure, and has no therapeutic or diagnostic intent (e.g., screening studies, microdose studies). " ] ;
           fhir:designation ( [
             fhir:use [
               fhir:display [ fhir:v "Alternative term" ]
             ] ;
             fhir:value [ fhir:v "Phase 0 study" ]
           ] [
             fhir:use [
               fhir:display [ fhir:v "Alternative term" ]
             ] ;
             fhir:value [ fhir:v "Pre-clinical trial" ]
           ] [
             fhir:use [
               fhir:display [ fhir:v "Alternative term" ]
             ] ;
             fhir:value [ fhir:v "Exploratory IND study" ]
           ] )
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01032" ] ;
         fhir:display [ fhir:v "Phase 1/Phase 2 trial" ] ;
         fhir:definition [ fhir:v " A clinical trial with a component meeting the definition of phase 1 trial and a component meeting the definition of phase 2 trial." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase I/II trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 1-2 trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 1/2 trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Trial phase 1-2" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Trial phase 1/2" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01033" ] ;
         fhir:display [ fhir:v "Phase 2 trial" ] ;
         fhir:definition [ fhir:v "A clinical trial to gather evidence of effectiveness and safety for an intervention in patients with the disease or condition under study, but not intended to provide an adequate basis for regulatory approval for clinical use." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase II trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "phase 2 study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Exploratory clinical study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "phase II clinical trial" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01034" ] ;
         fhir:display [ fhir:v "Phase 2/Phase 3 trial" ] ;
         fhir:definition [ fhir:v "A clinical trial with a component meeting the definition of phase 2 trial and a component meeting the definition of phase 3 trial." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase II/III trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 2-3 trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 2/3 trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Trial phase 2-3" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Trial phase 2/3" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01035" ] ;
         fhir:display [ fhir:v "Phase 3 Trial" ] ;
         fhir:definition [ fhir:v "A clinical trial to gather the evidence of effectiveness and safety of an intervention, intended to provide an adequate basis for regulatory approval for clinical use." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase III trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "phase 3 study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Confirmatory clinical study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "phase III clinical trial" ]
         ] )
       ] [
         fhir:code [ fhir:v "SEVCO:01036" ] ;
         fhir:display [ fhir:v "Post-marketing study" ] ;
         fhir:definition [ fhir:v "A clinical trial to gather additional evidence of effectiveness and safety of an intervention for an already approved clinical use." ] ;
         fhir:designation ( [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase IV trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 4 trial" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Phase 4 study" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Trial phase 4" ]
         ] [
           fhir:use [
             fhir:display [ fhir:v "Alternative term" ]
           ] ;
           fhir:value [ fhir:v "Post-approval study" ]
         ] )
       ] )
     ] )
  ] [
     fhir:code [ fhir:v "SEVCO:01002" ] ;
     fhir:display [ fhir:v "Observational research" ] ;
     fhir:definition [ fhir:v "A study design in which the independent variables (exposures or interventions) are not prospectively assigned or modified by the investigator. " ] ;
     fhir:designation ( [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Observational Study" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Observational Study Design" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Observational primary research" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "observational method of research" ]
     ] [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Non-interventional research" ]
     ] ) ;
     fhir:concept ( [
       fhir:code [ fhir:v "SEVCO:01037" ] ;
       fhir:display [ fhir:v "Post-Marketing Surveillance study" ] ;
       fhir:definition [ fhir:v "An observational study to identify adverse events related to the use of an approved clinical intervention." ] ;
       fhir:designation ( [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Postmarketing evaluation study" ]
       ] )
     ] )
  ] [
     fhir:code [ fhir:v "SEVCO:01010" ] ;
     fhir:display [ fhir:v "Comparative study design" ] ;
     fhir:definition [ fhir:v "A study design in which two or more groups are compared." ] ;
     fhir:designation ( [
       fhir:use [
         fhir:display [ fhir:v "Alternative term" ]
       ] ;
       fhir:value [ fhir:v "Comparative research" ]
     ] ) ;
     fhir:concept ( [
       fhir:code [ fhir:v "SEVCO:01011" ] ;
       fhir:display [ fhir:v "Parallel cohort design" ] ;
       fhir:definition [ fhir:v "A comparative study design in which the groups are compared concurrently and participants are expected to remain in the groups being compared for the entire duration of participation in the study." ] ;
       fhir:designation ( [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Concurrent cohort study" ]
       ] )
     ] [
       fhir:code [ fhir:v "SEVCO:01012" ] ;
       fhir:display [ fhir:v "Crossover cohort design" ] ;
       fhir:definition [ fhir:v "A comparative study design in which participants receive two or more alternative exposures during separate periods of time." ] ;
       fhir:designation ( [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Crossover study" ]
       ] [
         fhir:use [
           fhir:display [ fhir:v "Alternative term" ]
         ] ;
         fhir:value [ fhir:v "Crossover trial" ]
       ] ) ;
       fhir:concept ( [
         fhir:code [ fhir:v "SEVCO:01024" ] ;
         fhir:display [ fhir:v "Controlled crossover cohort design" ] ;
         fhir:definition [ fhir:v "A crossover cohort design in which two or more cohorts have different orders of exposures." ]
       ] [
         fhir:code [ fhir:v "SEVCO:01025" ] ;
         fhir:display [ fhir:v "Single-arm crossover design" ] ;
         fhir:definition [ fhir:v "A crossover cohort design in which all participants are in a single cohort with the same order of exposures." ]
       ] )
     ] [
       fhir:code [ fhir:v "SEVCO:01013" ] ;
