     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/sort-direction</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">ascending\n                  <a name=\"sort-direction-ascending\"> </a>\n                </td>\n                <td>Ascending</td>\n                <td>Sort by the value ascending, so that lower values appear first.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">descending\n                  <a name=\"sort-direction-descending\"> </a>\n                </td>\n                <td>Descending</td>\n                <td>Sort by the value descending, so that lower values appear last.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
