  fhir:concept ( [
     fhir:code [ fhir:v "in-progress" ] ;
     fhir:display [ fhir:v "In Progress" ] ;
     fhir:definition [ fhir:v "Transport has started but not completed." ]
  ] [
     fhir:code [ fhir:v "completed" ] ;
     fhir:display [ fhir:v "Completed" ] ;
     fhir:definition [ fhir:v "Transport has been completed." ]
  ] [
     fhir:code [ fhir:v "abandoned" ] ;
     fhir:display [ fhir:v "Abandoned" ] ;
     fhir:definition [ fhir:v "Transport was started but not completed." ]
  ] [
     fhir:code [ fhir:v "cancelled" ] ;
     fhir:display [ fhir:v "Cancelled" ] ;
     fhir:definition [ fhir:v "Transport was cancelled before started." ]
  ] [
     fhir:code [ fhir:v "planned" ] ;
     fhir:display [ fhir:v "Planned" ] ;
     fhir:definition [ fhir:v "Planned transport that is not yet requested." ]
  ] [
     fhir:code [ fhir:v "entered-in-error" ] ;
     fhir:display [ fhir:v "Entered In Error" ] ;
     fhir:definition [ fhir:v "This electronic record should never have existed, though it is possible that real-world decisions were based on it. (If real-world activity has occurred, the status should be \"abandoned\" rather than \"entered-in-error\".)." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/transport-status-reason> a fhir:CodeSystem ;
