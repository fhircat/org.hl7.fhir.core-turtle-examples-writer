           ] )
         ] [
           fhir:code [ fhir:v "PaymentNotice" ] ;
           fhir:display [ fhir:v "PaymentNotice" ] ;
           fhir:definition [ fhir:v "This resource provides the status of the payment for goods and services rendered, and the request and response resource references." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "PaymentReconciliation" ] ;
           fhir:display [ fhir:v "PaymentReconciliation" ] ;
           fhir:definition [ fhir:v "This resource provides the details including amount of a payment and allocates the payment items being paid." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Permission" ] ;
           fhir:display [ fhir:v "Permission" ] ;
           fhir:definition [ fhir:v "Permission resource holds access rules for a given data and context." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Person" ] ;
           fhir:display [ fhir:v "Person" ] ;
           fhir:definition [ fhir:v "Demographics and administrative information about a person independent of a specific health-related context." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "PlanDefinition" ] ;
           fhir:display [ fhir:v "PlanDefinition" ] ;
           fhir:definition [ fhir:v "This resource allows for the definition of various types of plans as a sharable, consumable, and executable artifact. The resource is general enough to support the description of a broad range of clinical and non-clinical artifacts such as clinical decision support rules, order sets, protocols, and drug quality specifications." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Practitioner" ] ;
           fhir:display [ fhir:v "Practitioner" ] ;
           fhir:definition [ fhir:v "A person who is directly or indirectly involved in the provisioning of healthcare or related services." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "PractitionerRole" ] ;
           fhir:display [ fhir:v "PractitionerRole" ] ;
           fhir:definition [ fhir:v "A specific set of Roles/Locations/specialties/services that a practitioner may perform, or has performed at an organization during a period of time." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Procedure" ] ;
           fhir:display [ fhir:v "Procedure" ] ;
           fhir:definition [ fhir:v "An action that is or was performed on or for a patient, practitioner, device, organization, or location. For example, this can be a physical intervention on a patient like an operation, or less invasive like long term services, counseling, or hypnotherapy.  This can be a quality or safety inspection for a location, organization, or device.  This can be an accreditation procedure on a practitioner for licensing." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Provenance" ] ;
           fhir:display [ fhir:v "Provenance" ] ;
           fhir:definition [ fhir:v "Provenance of a resource is a record that describes entities and processes involved in producing and delivering or otherwise influencing that resource. Provenance provides a critical foundation for assessing authenticity, enabling trust, and allowing reproducibility. Provenance assertions are a form of contextual metadata and can themselves become important records with their own provenance. Provenance statement indicates clinical significance in terms of confidence in authenticity, reliability, and trustworthiness, integrity, and stage in lifecycle (e.g. Document Completion - has the artifact been legally authenticated), all of which may impact security, privacy, and trust policies." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Questionnaire" ] ;
           fhir:display [ fhir:v "Questionnaire" ] ;
           fhir:definition [ fhir:v "A structured set of questions intended to guide the collection of answers from end-users. Questionnaires provide detailed control over order, presentation, phraseology and grouping to allow coherent, consistent data collection." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "QuestionnaireResponse" ] ;
           fhir:display [ fhir:v "QuestionnaireResponse" ] ;
           fhir:definition [ fhir:v "A structured set of questions and their answers. The questions are ordered and grouped into coherent subsets, corresponding to the structure of the grouping of the questionnaire being responded to." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "RegulatedAuthorization" ] ;
           fhir:display [ fhir:v "RegulatedAuthorization" ] ;
           fhir:definition [ fhir:v "Regulatory approval, clearance or licencing related to a regulated product, treatment, facility or activity that is cited in a guidance, regulation, rule or legislative act. An example is Market Authorization relating to a Medicinal Product." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "RelatedPerson" ] ;
           fhir:display [ fhir:v "RelatedPerson" ] ;
           fhir:definition [ fhir:v "Information about a person that is involved in a patient's health or the care for a patient, but who is not the target of healthcare, nor has a formal responsibility in the care process." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "RequestOrchestration" ] ;
           fhir:display [ fhir:v "RequestOrchestration" ] ;
           fhir:definition [ fhir:v "A set of related requests that can be used to capture intended activities that have inter-dependencies such as \"give this medication after that one\"." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Requirements" ] ;
           fhir:display [ fhir:v "Requirements" ] ;
           fhir:definition [ fhir:v "The Requirements resource is used to describe an actor - a human or an application that plays a role in data exchange, and that may have obligations associated with the role the actor plays." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ResearchStudy" ] ;
           fhir:display [ fhir:v "ResearchStudy" ] ;
           fhir:definition [ fhir:v "A scientific study of nature that sometimes includes processes involved in health and disease. For example, clinical trials are research studies that involve people. These studies may be related to new ways to screen, prevent, diagnose, and treat disease. They may also study certain outcomes and certain groups of people by looking at data collected in the past or future." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ResearchSubject" ] ;
           fhir:display [ fhir:v "ResearchSubject" ] ;
           fhir:definition [ fhir:v "A ResearchSubject is a participant or object which is the recipient of investigative activities in a research study." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "RiskAssessment" ] ;
           fhir:display [ fhir:v "RiskAssessment" ] ;
           fhir:definition [ fhir:v "An assessment of the likely outcome(s) for a patient or other subject as well as the likelihood of each outcome." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Schedule" ] ;
           fhir:display [ fhir:v "Schedule" ] ;
           fhir:definition [ fhir:v "A container for slots of time that may be available for booking appointments." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SearchParameter" ] ;
           fhir:display [ fhir:v "SearchParameter" ] ;
           fhir:definition [ fhir:v "A search parameter that defines a named search item that can be used to search/filter on a resource." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ServiceRequest" ] ;
           fhir:display [ fhir:v "ServiceRequest" ] ;
           fhir:definition [ fhir:v "A record of a request for service such as diagnostic investigations, treatments, or operations to be performed." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Slot" ] ;
           fhir:display [ fhir:v "Slot" ] ;
           fhir:definition [ fhir:v "A slot of time on a schedule that may be available for booking appointments." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Specimen" ] ;
           fhir:display [ fhir:v "Specimen" ] ;
           fhir:definition [ fhir:v "A sample to be used for analysis." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SpecimenDefinition" ] ;
           fhir:display [ fhir:v "SpecimenDefinition" ] ;
           fhir:definition [ fhir:v "A kind of specimen with associated set of requirements." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "StructureDefinition" ] ;
           fhir:display [ fhir:v "StructureDefinition" ] ;
           fhir:definition [ fhir:v "A definition of a FHIR structure. This resource is used to describe the underlying resources, data types defined in FHIR, and also for describing extensions and constraints on resources and data types." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "StructureMap" ] ;
           fhir:display [ fhir:v "StructureMap" ] ;
           fhir:definition [ fhir:v "A Map of relationships between 2 structures that can be used to transform data." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Subscription" ] ;
           fhir:display [ fhir:v "Subscription" ] ;
           fhir:definition [ fhir:v "The subscription resource describes a particular client's request to be notified about a SubscriptionTopic." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubscriptionStatus" ] ;
           fhir:display [ fhir:v "SubscriptionStatus" ] ;
           fhir:definition [ fhir:v "The SubscriptionStatus resource describes the state of a Subscription during notifications. It is not persisted." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubscriptionTopic" ] ;
           fhir:display [ fhir:v "SubscriptionTopic" ] ;
           fhir:definition [ fhir:v "Describes a stream of resource state changes identified by trigger criteria and annotated with labels useful to filter projections from this topic." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Substance" ] ;
           fhir:display [ fhir:v "Substance" ] ;
           fhir:definition [ fhir:v "A homogeneous material with a definite composition." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubstanceDefinition" ] ;
           fhir:display [ fhir:v "SubstanceDefinition" ] ;
           fhir:definition [ fhir:v "The detailed description of a substance, typically at a level beyond what is used for prescribing." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubstanceNucleicAcid" ] ;
           fhir:display [ fhir:v "SubstanceNucleicAcid" ] ;
           fhir:definition [ fhir:v "Nucleic acids are defined by three distinct elements: the base, sugar and linkage. Individual substance/moiety IDs will be created for each of these elements. The nucleotide sequence will be always entered in the 5’-3’ direction." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubstancePolymer" ] ;
           fhir:display [ fhir:v "SubstancePolymer" ] ;
           fhir:definition [ fhir:v "Properties of a substance specific to it being a polymer." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubstanceProtein" ] ;
           fhir:display [ fhir:v "SubstanceProtein" ] ;
           fhir:definition [ fhir:v "A SubstanceProtein is defined as a single unit of a linear amino acid sequence, or a combination of subunits that are either covalently linked or have a defined invariant stoichiometric relationship. This includes all synthetic, recombinant and purified SubstanceProteins of defined sequence, whether the use is therapeutic or prophylactic. This set of elements will be used to describe albumins, coagulation factors, cytokines, growth factors, peptide/SubstanceProtein hormones, enzymes, toxins, toxoids, recombinant vaccines, and immunomodulators." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubstanceReferenceInformation" ] ;
           fhir:display [ fhir:v "SubstanceReferenceInformation" ] ;
           fhir:definition [ fhir:v "Todo." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SubstanceSourceMaterial" ] ;
           fhir:display [ fhir:v "SubstanceSourceMaterial" ] ;
           fhir:definition [ fhir:v "Source material shall capture information on the taxonomic and anatomical origins as well as the fraction of a material that can result in or can be modified to form a substance. This set of data elements shall be used to define polymer substances isolated from biological matrices. Taxonomic and anatomical origins shall be described using a controlled vocabulary as required. This information is captured for naturally derived polymers ( . starch) and structurally diverse substances. For Organisms belonging to the Kingdom Plantae the Substance level defines the fresh material of a single species or infraspecies, the Herbal Drug and the Herbal preparation. For Herbal preparations, the fraction information will be captured at the Substance information level and additional information for herbal extracts will be captured at the Specified Substance Group 1 information level. See for further explanation the Substance Class: Structurally Diverse and the herbal annex." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SupplyDelivery" ] ;
           fhir:display [ fhir:v "SupplyDelivery" ] ;
           fhir:definition [ fhir:v "Record of delivery of what is supplied." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "SupplyRequest" ] ;
           fhir:display [ fhir:v "SupplyRequest" ] ;
           fhir:definition [ fhir:v "A record of a non-patient specific request for a medication, substance, device, certain types of biologically derived product, and nutrition product used in the healthcare setting." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Task" ] ;
           fhir:display [ fhir:v "Task" ] ;
           fhir:definition [ fhir:v "A task to be performed." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "TerminologyCapabilities" ] ;
           fhir:display [ fhir:v "TerminologyCapabilities" ] ;
           fhir:definition [ fhir:v "A TerminologyCapabilities resource documents a set of capabilities (behaviors) of a FHIR Terminology Server that may be used as a statement of actual server functionality or a statement of required or desired server implementation." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "TestPlan" ] ;
           fhir:display [ fhir:v "TestPlan" ] ;
           fhir:definition [ fhir:v "A plan for executing testing on an artifact or specifications" ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "TestReport" ] ;
           fhir:display [ fhir:v "TestReport" ] ;
           fhir:definition [ fhir:v "A summary of information based on the results of executing a TestScript." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "TestScript" ] ;
           fhir:display [ fhir:v "TestScript" ] ;
           fhir:definition [ fhir:v "A structured set of tests against a FHIR server or client implementation to determine compliance against the FHIR specification." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Transport" ] ;
           fhir:display [ fhir:v "Transport" ] ;
           fhir:definition [ fhir:v "Record of transport." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ValueSet" ] ;
           fhir:display [ fhir:v "ValueSet" ] ;
           fhir:definition [ fhir:v "A ValueSet resource instance specifies a set of codes drawn from one or more code systems, intended for use in a particular context. Value sets link between [[[CodeSystem]]] definitions and their use in [coded elements](terminologies.html)." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "VerificationResult" ] ;
           fhir:display [ fhir:v "VerificationResult" ] ;
           fhir:definition [ fhir:v "Describes validation requirements, source(s), status and dates for one or more elements." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "VisionPrescription" ] ;
           fhir:display [ fhir:v "VisionPrescription" ] ;
           fhir:definition [ fhir:v "An authorization for the provision of glasses and/or contact lenses to a patient." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "resource"
             ]
           ] )
         ] )
       ] [
         fhir:code [ fhir:v "Parameters" ] ;
         fhir:display [ fhir:v "Parameters" ] ;
         fhir:definition [ fhir:v "This resource is used to pass information into and back from an operation (whether invoked directly from REST or within a messaging environment).  It is not persisted or allowed to be referenced by other resources except as described in the definition of the Parameters resource." ] ;
         fhir:property ( [
           fhir:code [ fhir:v "kind" ] ;
           fhir:value [
             a fhir:code ;
