hed food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228059003\">228059003</a>\n                    </td>\n                    <td>Soft food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/441791000124106\">441791000124106</a>\n                    </td>\n                    <td>Strained food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228055009\">228055009</a>\n                    </td>\n                    <td>Liquidized food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228056005\">228056005</a>\n                    </td>\n                    <td>Lumpy food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/441771000124105\">441771000124105</a>\n                    </td>\n                    <td>Moist food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228057001\">228057001</a>\n                    </td>\n                    <td>Semi-solid food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228058006\">228058006</a>\n                    </td>\n                    <td>Single texture food</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228060008\">228060008</a>\n                    </td>\n                    <td>Solid food</td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral
