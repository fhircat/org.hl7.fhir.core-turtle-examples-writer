  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "closed" ] ;
     fhir:display [ fhir:v "Closed" ] ;
     fhir:definition [ fhir:v "No additional content is allowed other than that described by the slices in this profile." ]
  ] [
     fhir:code [ fhir:v "open" ] ;
     fhir:display [ fhir:v "Open" ] ;
     fhir:definition [ fhir:v "Additional content is allowed anywhere in the list." ]
  ] [
     fhir:code [ fhir:v "openAtEnd" ] ;
     fhir:display [ fhir:v "Open at End" ] ;
     fhir:definition [ fhir:v "Additional content is allowed, but only at the end of the list. Note that using this requires that the slices be ordered, which makes it hard to share uses. This should only be done where absolutely required." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/resource-aggregation-mode> a fhir:CodeSystem ;
  fhir:id [ fhir:v "resource-aggregation-mode"] ; # 
