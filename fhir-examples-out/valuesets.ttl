<http://hl7.org/fhir/ValueSet/route-codes> a fhir:ValueSet ;
  fhir:id [ fhir:v "route-codes"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
