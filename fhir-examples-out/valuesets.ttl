  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/action-participant-function</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">performer\n                  <a name=\"action-participant-function-performer\"> </a>\n                </td>\n                <td>Performer</td>\n                <td>The participant is the performer of the action.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">author\n                  <a name=\"action-participant-function-author\"> </a>\n                </td>\n                <td>Author</td>\n                <td>The participant is the author of the result of the action.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">reviewer\n                  <a name=\"action-participant-function-reviewer\"> </a>\n                </td>\n                <td>Reviewer</td>\n                <td>The participant is reviewing the result of the action.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">witness\n                  <a name=\"action-participant-function-witness\"> </a>\n                </td>\n                <td>Witness</td>\n                <td>The participant is a witness to the action being performed.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
