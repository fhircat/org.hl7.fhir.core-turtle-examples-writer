  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/deviceassociation-operationstatus</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">on\n                  <a name=\"deviceassociation-operationstatus-on\"> </a>\n                </td>\n                <td>On</td>\n                <td>The device is working or switched on, i.e. active.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">off\n                  <a name=\"deviceassociation-operationstatus-off\"> </a>\n                </td>\n                <td>Off</td>\n                <td>The device is inactive, switched off, or deactivated.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">standby\n                  <a name=\"deviceassociation-operationstatus-standby\"> </a>\n                </td>\n                <td>Stand By</td>\n                <td>The device is in stand-by mode i.e. not actively working but not powered off.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">defective\n                  <a name=\"deviceassociation-operationstatus-defective\"> </a>\n                </td>\n                <td>Stand By</td>\n                <td>The device is defective or for maintenance and is not available or working.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">unknown\n                  <a name=\"deviceassociation-operationstatus-unknown\"> </a>\n                </td>\n                <td>Unknown</td>\n                <td>The operational status of the device has not been determined.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
