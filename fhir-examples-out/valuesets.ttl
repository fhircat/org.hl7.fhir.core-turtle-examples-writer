     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/metric-operational-status</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">on\n                  <a name=\"metric-operational-status-on\"> </a>\n                </td>\n                <td>On</td>\n                <td>The DeviceMetric is operating and will generate Observations.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">off\n                  <a name=\"metric-operational-status-off\"> </a>\n                </td>\n                <td>Off</td>\n                <td>The DeviceMetric is not operating.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">standby\n                  <a name=\"metric-operational-status-standby\"> </a>\n                </td>\n                <td>Standby</td>\n                <td>The DeviceMetric is operating, but will not generate any Observations.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">entered-in-error\n                  <a name=\"metric-operational-status-entered-in-error\"> </a>\n                </td>\n                <td>Entered In Error</td>\n                <td>The DeviceMetric was entered in error.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
