<http://hl7.org/fhir/CodeSystem/contributor-summary-style> a fhir:CodeSystem ;
  fhir:id [ fhir:v "contributor-summary-style"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2023-03-26T15:21:02.749+11:00"^^xsd:dateTime ] ;
     fhir:profile ( [
