  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This code system \n              <code>http://hl7.org/fhir/encounter-location-status</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">planned\n                  <a name=\"encounter-location-status-planned\"> </a>\n                </td>\n                <td>Planned</td>\n                <td>The patient is planned to be moved to this location at some point in the future.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">active\n                  <a name=\"encounter-location-status-active\"> </a>\n                </td>\n                <td>Active</td>\n                <td>The patient is currently at this location, or was between the period specified.\n\nA system may update these records when the patient leaves the location to either reserved, or completed.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">reserved\n                  <a name=\"encounter-location-status-reserved\"> </a>\n                </td>\n                <td>Reserved</td>\n                <td>This location is held empty for this patient.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">completed\n                  <a name=\"encounter-location-status-completed\"> </a>\n                </td>\n                <td>Completed</td>\n                <td>The patient was at this location during the period specified.\n\nNot to be used when the patient is currently at the location.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
