0000111073\n                  <a name=\"animal-tissue-type-100000111073\"> </a>\n                </td>\n                <td>Fore-stomach (ruminants only)</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111074\n                  <a name=\"animal-tissue-type-100000111074\"> </a>\n                </td>\n                <td>Gingival tissue</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111075\n                  <a name=\"animal-tissue-type-100000111075\"> </a>\n                </td>\n                <td>Hair</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111076\n                  <a name=\"animal-tissue-type-100000111076\"> </a>\n                </td>\n                <td>Heart/pericardium</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111077\n                  <a name=\"animal-tissue-type-100000111077\"> </a>\n                </td>\n                <td>Hide</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111078\n                  <a name=\"animal-tissue-type-100000111078\"> </a>\n                </td>\n                <td>Hooves</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111079\n                  <a name=\"animal-tissue-type-100000111079\"> </a>\n                </td>\n                <td>Ileum</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111080\n                  <a name=\"animal-tissue-type-100000111080\"> </a>\n                </td>\n                <td>Jejunum</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000111081\n                  <a name=\"animal-tissue-type-100000111081\"> </a>\n                </td>\n                <td>Kidne