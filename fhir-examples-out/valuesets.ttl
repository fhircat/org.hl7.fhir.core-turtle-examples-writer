  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p>This value set includes codes based on the following rules:</p>\n            <ul>\n              <li>Include codes from \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a> where concept  is-a  404684003 (Clinical finding)\n              </li>\n              <li>Include codes from \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a> where concept  is-a  71388002 (Procedure)\n              </li>\n              <li>Include codes from \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a> where concept  is-a  243796009 (Context-dependent categories)\n              </li>\n              <li>Include codes from \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a> where concept  is-a  272379006 (Events)\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral
  ] ; # 
