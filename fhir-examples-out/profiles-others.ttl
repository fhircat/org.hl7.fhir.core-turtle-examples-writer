  ] ) ; # 
  fhir:description [ fhir:v "FHIR Vital Signs Profile"] ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:mapping ( [
     fhir:identity [ fhir:v "workflow" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/fhir/workflow"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/workflow>
     ] ;
     fhir:name [ fhir:v "Workflow Pattern" ]
  ] [
     fhir:identity [ fhir:v "sct-concept" ] ;
     fhir:uri [
       fhir:v "http://snomed.info/conceptdomain"^^xsd:anyURI ;
       fhir:l <http://snomed.info/conceptdomain>
     ] ;
     fhir:name [ fhir:v "SNOMED CT Concept Domain Binding" ]
  ] [
     fhir:identity [ fhir:v "v2" ] ;
     fhir:uri [
