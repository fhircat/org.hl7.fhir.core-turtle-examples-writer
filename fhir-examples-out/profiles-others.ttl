       ] [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "OBX-2, OBX-5, OBX-6" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "value" ]
       ] [
         fhir:identity [ fhir:v "sct-attr" ] ;
