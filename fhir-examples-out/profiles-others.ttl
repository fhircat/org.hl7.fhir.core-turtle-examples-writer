       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "Entity, Role, or Act,Observation[classCode=OBS, moodCode=EVN]" ]
       ] [
         fhir:identity [ fhir:v "workflow" ] ;
         fhir:map [ fhir:v "Event" ]
       ] [
         fhir:identity [ fhir:v "w5" ] ;
         fhir:map [ fhir:v "clinical.diagnostics" ]
       ] [
         fhir:identity [ fhir:v "sct-concept" ] ;
         fhir:map [ fhir:v "< 363787002 |Observable entity|" ]
       ] [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "OBX" ]
       ] )
