  ] ) ; # 
  fhir:version [ fhir:v "5.0.0"] ; # 
  fhir:name [ fhir:v "ClinicalDocument"] ; # 
  fhir:title [ fhir:v "Clinical  Document"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2015-03-17"^^xsd:date] ; # 
