         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "If there is an implicit hierarchy, a hierarchyMeaning should be provided" ] ;
         fhir:expression [ fhir:v "concept.where(property.code = 'parent' or property.code = 'child').exists() implies hierarchyMeaning.exists()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/CodeSystem"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/CodeSystem>
         ]
       ] [
         fhir:key [ fhir:v "csd-4" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "If the code system content = supplement, it must nominate what it's a supplement for" ] ;
