       fhir:short [ fhir:v "Additional identifier for the library" ] ;
       fhir:definition [ fhir:v "A formal identifier that is used to identify this library when it is represented in other formats, or referenced in a specification, model, design or an instance. e.g. CMS or NQF identifiers for a measure artifact. Note that at least one identifier is required for non-experimental active artifacts." ] ;
       fhir:comment [ fhir:v "Typically, this is used for identifiers that can go in an HL7 V3 II (instance identifier) data type, and can then identify this library outside of FHIR, where it is not possible to use the logical URI." ] ;
