       fhir:orderMeaning [ fhir:v "For bundles of type 'document' and 'message', the first resource is special (must be Composition or MessageHeader respectively). For all bundles, the meaning of the order of entries depends on the bundle type" ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "bdl-5" ] ;
