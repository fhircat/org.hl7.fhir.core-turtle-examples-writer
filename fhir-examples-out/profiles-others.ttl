         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "If there is an explicit hierarchy, a hierarchyMeaning should be provided" ] ;
         fhir:expression [ fhir:v "concept.concept.exists() implies hierarchyMeaning.exists()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/CodeSystem"^^xsd:anyURI ;
