  fhir:snapshot [
     fhir:element ( [
       fhir:id [ fhir:v "Library" ] ;
       fhir:path [ fhir:v "Library" ] ;
       fhir:short [ fhir:v "Represents a library of quality improvement components" ] ;
       fhir:definition [ fhir:v "The Library resource is a general-purpose container for knowledge asset definitions. It can be used to describe and expose existing knowledge assets such as logic libraries and information model descriptions, as well as to describe a collection of knowledge assets." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Library" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:constraint ( [
