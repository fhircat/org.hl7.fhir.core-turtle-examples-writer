         fhir:path [ fhir:v "NamingSystem.url" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "uri"^^xsd:anyURI ;
