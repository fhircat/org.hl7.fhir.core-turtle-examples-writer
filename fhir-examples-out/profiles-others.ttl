<http://hl7.org/fhir/StructureDefinition/clinicaldocument> a fhir:StructureDefinition ;
  fhir:id [ fhir:v "clinicaldocument"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
