       fhir:l <http://hl7.org/v2>
     ] ;
     fhir:name [ fhir:v "HL7 V2 Mapping" ]
  ] [
     fhir:identity [ fhir:v "rim" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/v3"^^xsd:anyURI ;
