  fhir:date [ fhir:v "2016-03-25"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "Health Level Seven International (Orders and Observations Workgroup)"] ; # 
  fhir:contact ( [
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
