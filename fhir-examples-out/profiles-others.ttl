         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "If a codesystem contains example, fragment, or complete content, it must have at least one concept" ] ;
         fhir:expression [ fhir:v "content in ( 'example' | 'fragment' | 'complete' ) implies concept.exists()" ]
