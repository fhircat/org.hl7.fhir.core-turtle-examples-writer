         fhir:key [ fhir:v "vs-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "if Observation.effective[x] is dateTime and has a value then that value shall be precise to the day" ] ;
         fhir:expression [ fhir:v "($this as dateTime).toString().length() >= 8" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/vitalsigns"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/vitalsigns>
         ]
