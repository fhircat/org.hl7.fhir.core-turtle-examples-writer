         fhir:expression [ fhir:v "extension('http://hl7.org/fhir/StructureDefinition/valueset-rules-text').exists() xor extension('http://hl7.org/fhir/StructureDefinition/valueset-expression').exists() xor compose.exists()" ]
       ] ) ;
       fhir:mustSupport [ fhir:v false ] ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
